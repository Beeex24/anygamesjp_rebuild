---
/** WebP版があればそれを優先し、なければ元画像をそのまま出す。元のURLは変えない(<img> は元画像のまま)。 */
import { webpFor } from '../lib/webp';

interface Props {
  src: string;
  alt?: string;
  width?: number | string;
  height?: number | string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}
const { src, alt = '', width, height, loading = 'lazy', fetchpriority, class: cls } = Astro.props;
const webp = webpFor(src);
---
<picture>
  {webp && <source srcset={webp} type="image/webp" />}
  <img src={src} alt={alt} width={width} height={height} loading={loading} fetchpriority={fetchpriority} decoding="async" class={cls} />
</picture>
<style>
  picture { display: contents; }
</style>
