---
import { postUrl, sectionLabel, formatDate, SECTION_COLORS, type Post } from '../lib/site';
interface Props { post: Post; eager?: boolean }
const { post, eager = false } = Astro.props;
const { title, description, pubDate, heroImage } = post.data;
// 公開から14日以内はNEW(ビルド時点で判定)
const isNew = Date.now() - pubDate.valueOf() < 14 * 24 * 3600 * 1000;
---
<article class="card">
  <a class="link" href={postUrl(post)}>
    <div class="thumb">
      {heroImage
        ? <img src={heroImage} alt="" width="640" height="360" loading={eager ? 'eager' : 'lazy'} decoding="async" />
        : <span class="noimg" aria-hidden="true">ANYGAMES</span>}
      {isNew && <span class="new">NEW</span>}
      <span class="tag" style={`background:${SECTION_COLORS[post.collection] ?? 'var(--accent)'}`}>{sectionLabel(post.collection)}</span>
    </div>
    <div class="body">
      <h3>{title}</h3>
      <p class="desc">{description}</p>
      <div class="foot">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="more">続きを読む</span>
      </div>
    </div>
  </a>
</article>
<style>
  .card { border-radius: var(--card-radius); overflow: hidden; background: var(--bg); height: 100%; box-shadow: var(--shadow); border: 1px solid var(--line); box-shadow: none; }
  .card:hover { border-color: var(--c, var(--accent)); }
  .card:hover h3 { color: var(--c, var(--accent)); }
  .link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .thumb { position: relative; aspect-ratio: 16 / 9; background: var(--bg-soft); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s; }
  .card:hover .thumb img { transform: scale(1.04); }
  .noimg { display: grid; place-items: center; height: 100%; font-weight: 800; color: var(--line); }
  .new { position: absolute; right: 10px; top: 10px; padding: 1px 8px; border-radius: 2px; background: #ff3d57; color: #fff; font-size: .7rem; font-weight: 800; letter-spacing: .05em; }
  .tag { position: absolute; left: 10px; bottom: 10px; padding: 2px 8px; border-radius: 2px; color: #fff; font-size: .7rem; font-weight: 700; }
  .body { display: flex; flex-direction: column; flex: 1; padding: 14px 16px 16px; }
  h3 { font-size: 1rem; line-height: 1.5; margin: 0 0 8px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .desc { margin: 0 0 12px; font-size: .85rem; color: var(--text-sub); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: .78rem; color: var(--text-sub); }
  .more { color: var(--c, var(--accent)); font-weight: 700; font-size: .78rem; }
  .more::after { content: ' ›'; }
  @media (max-width: 639px) {
    .body { padding: 8px 10px 10px; }
    h3 { font-size: .85rem; line-height: 1.45; margin-bottom: 6px; -webkit-line-clamp: 3; }
    .desc, .more { display: none; }
    .foot { font-size: .7rem; }
    .tag { left: 6px; bottom: 6px; font-size: .62rem; padding: 1px 6px; }
    .new { right: 6px; top: 6px; font-size: .6rem; }
  }
</style>
