---
import { ADSENSE_CLIENT, ADS } from '../consts';
interface Props { slot?: keyof typeof ADS }
const { slot = 'listFeed' } = Astro.props;
---
<div class="ad" aria-label="広告">
  <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={ADS[slot]} data-ad-format="auto" data-full-width-responsive="true"></ins>
  <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>
<style>
  /* 読み込み前後でレイアウトがずれないよう最小高さを確保 */
  .ad { min-height: 100px; margin: 24px 0; }
</style>
