---
import { formatDate } from '../lib/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSenseScript from './AdSenseScript.astro';
import { getCollection } from 'astro:content';
import { sortByDate } from '../lib/list';
import '../styles/mc.css';

const mods = sortByDate(await getCollection('minecraft_mod_blog'));
const arr = <T,>(v: T | T[] | undefined): T[] => (v === undefined ? [] : Array.isArray(v) ? v : [v]);
const dlNum = (s?: string) => {
  const m = /^([\d.]+)\s*([KkMm]?)/.exec(s ?? '');
  if (!m) return 0;
  return parseFloat(m[1]) * ({ k: 1e3, m: 1e6 }[m[2].toLowerCase() as 'k' | 'm'] ?? 1);
};
const items = mods.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  heroImage: p.data.heroImage,
  versions: arr(p.data.version),
  category: p.data.category ?? '',
  difficulty: p.data.difficulty ?? '',
  loaders: arr(p.data.modLoader),
  downloads: p.data.downloads ?? '',
  dl: dlNum(p.data.downloads),
  tags: p.data.tags ?? [],
  pub: p.data.pubDate.valueOf(),
  upd: (p.data.updatedDate ?? p.data.pubDate).valueOf(),
  pubDate: p.data.pubDate,
}));
const uniq = (xs: string[]) => [...new Set(xs.filter(Boolean))];
const count = (key: (i: (typeof items)[number]) => string[]) => {
  const m = new Map<string, number>();
  items.forEach((i) => uniq(key(i)).forEach((k) => m.set(k, (m.get(k) ?? 0) + 1)));
  return [...m.entries()].sort((a, b) => b[1] - a[1]);
};
const groups = [
  { key: 'version', label: 'マイクラバージョン', entries: count((i) => i.versions) },
  { key: 'category', label: 'カテゴリー', entries: count((i) => [i.category]) },
  { key: 'difficulty', label: '難易度', entries: count((i) => [i.difficulty]) },
].filter((g) => g.entries.length > 0);
const lead = 'マインクラフトMOD解説専門サイト - 見てわかる導入方法で分かりやすくを第一に';
const EMOJI: Record<string, string> = { '工業MOD': '⚙️', '農業・食品': '🌿', '冒険・戦闘': '⚔️', '建築・装飾': '🏗️', '魔法・呪文': '✨', '見た目・UI': '🎨', 'ユーティリティ': '🔧', 'ディメンションMOD': '🌍' };
const ICON: Record<string, string> = { version: '📦', category: '📁', difficulty: '〉' };
---
<BaseLayout title="マインクラフト MOD解説" description={lead} bodyClass="mc"
  breadcrumbs={[{ name: 'ホーム', href: '/' }, { name: 'MOD解説', href: '/minecraft_mod_blog/' }]}>
  <AdSenseScript slot="head" />
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" />

  <header class="mc-hero">
    <div class="in">
      <h1 class="mc-title mc-pixel">Minecraft MOD Database</h1>
      <p class="sub">{lead}</p>
    </div>
  </header>

  <div class="mc-wrap">
    <form class="search mc-box" role="search" onsubmit="return false">
      <label class="sr-only" for="q">MODを検索</label>
      <input id="q" type="search" placeholder="MOD名・キーワード" autocomplete="off" />
      <button type="button" class="mc-btn" id="go">🔍 検索</button>
    </form>

    <div class="layout">
      <aside class="side" aria-label="絞り込み">
        {groups.map((g) => (
          <details class="filter mc-box" data-group={g.key} open>
            <summary>{g.label}</summary>
            <div class="items">
              <button type="button" class="item all" data-value="" aria-pressed="true"><span>{ICON[g.key]} すべて</span><span class="n">{items.length}</span></button>
              {g.entries.filter(([k]) => k !== '不明').map(([k, n]) => (
                <button type="button" class="item" data-value={k} aria-pressed="false"><span>{g.key === 'category' ? (EMOJI[k] ?? '📁') : ICON[g.key]} {k}</span><span class="n">{n}</span></button>
              ))}
            </div>
          </details>
        ))}
      </aside>

      <section class="main" aria-label="MOD一覧">
        <div class="bar mc-box">
          <span id="result" aria-live="polite"></span>
          <label for="sort">並び順</label>
          <select id="sort">
            <option value="latest">新着順</option>
            <option value="updated">更新順</option>
            <option value="downloads">ダウンロード数順</option>
            <option value="name">名前順</option>
          </select>
          <button type="button" id="reset" class="reset">条件をクリア</button>
        </div>

        <ul id="grid" class="grid">
          {items.map((m, i) => (
            <li data-index={i}>
              <a class="card" href={`/minecraft_mod_blog/${m.id}/`}>
                <div class="thumb">
                  {m.heroImage
                    ? <img src={m.heroImage} alt="" width="640" height="360" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
                    : <span aria-hidden="true">🎮</span>}
                </div>
                <div class="body">
                  <h2>{m.title}</h2>
                  <p class="desc">{m.description}</p>
                  <p class="tags">
                    {m.versions.slice(0, 2).map((v) => <span class="mc-tag version">📦 {v}</span>)}
                    {m.category && <span class="mc-tag category">📁 {m.category}</span>}
                    {m.downloads && <span class="mc-tag downloads">⬇️ {m.downloads}</span>}
                    {m.difficulty && <span class="mc-tag difficulty">🎯 {m.difficulty}</span>}
                  </p>
                  <p class="date"><time datetime={new Date(m.upd).toISOString()}>{m.upd !== m.pub ? '更新' : '公開'}: {formatDate(new Date(m.upd))}</time></p>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <p id="empty" class="empty mc-box" hidden><span aria-hidden="true">🔍</span> 条件に合うMODが見つかりません。条件をクリアしてください。</p>
      </section>
    </div>
  </div>
  <script is:inline define:vars={{ data: items.map((m) => ({ t: (m.title + ' ' + m.description + ' ' + m.tags.join(' ')).toLowerCase(), name: m.title, version: m.versions, category: [m.category], difficulty: [m.difficulty], pub: m.pub, upd: m.upd, dl: m.dl })) }}>
    (function () {
      var grid = document.getElementById('grid');
      var cards = Array.prototype.slice.call(grid.children);
      var q = document.getElementById('q');
      var sort = document.getElementById('sort');
      var result = document.getElementById('result');
      var empty = document.getElementById('empty');
      var active = { version: [], category: [], difficulty: [] };
      function apply() {
        var s = q.value.toLowerCase().trim();
        var shown = 0;
        var order = data.map(function (d, i) { return i; }).sort(function (a, b) {
          var x = data[a], y = data[b], k = sort.value;
          if (k === 'name') return x.name.localeCompare(y.name, 'ja');
          if (k === 'updated') return y.upd - x.upd;
          if (k === 'downloads') return y.dl - x.dl;
          return y.pub - x.pub;
        });
        order.forEach(function (i) {
          var d = data[i], ok = d.t.indexOf(s) !== -1;
          ['version', 'category', 'difficulty'].forEach(function (g) {
            if (ok && active[g].length) ok = active[g].some(function (v) { return d[g].indexOf(v) !== -1; });
          });
          cards[i].hidden = !ok;
          grid.appendChild(cards[i]);
          if (ok) shown++;
        });
        result.textContent = shown + '件を表示中';
        empty.hidden = shown > 0;
      }
      function syncAll(fs, g) {
        fs.querySelector('.all').setAttribute('aria-pressed', String(active[g].length === 0));
      }
      document.querySelectorAll('[data-group]').forEach(function (fs) {
        var g = fs.getAttribute('data-group');
        fs.querySelectorAll('.item').forEach(function (chip) {
          chip.addEventListener('click', function () {
            var v = chip.getAttribute('data-value');
            if (v === '') { active[g] = []; fs.querySelectorAll('.item').forEach(function (c) { c.setAttribute('aria-pressed', 'false'); }); }
            else {
              var i = active[g].indexOf(v);
              if (i === -1) active[g].push(v); else active[g].splice(i, 1);
              chip.setAttribute('aria-pressed', String(i === -1));
            }
            syncAll(fs, g);
            apply();
          });
        });
      });
      q.addEventListener('input', apply);
      document.getElementById('go').addEventListener('click', apply);
      sort.addEventListener('change', apply);
      document.getElementById('reset').addEventListener('click', function () {
        q.value = ''; sort.value = 'latest';
        active = { version: [], category: [], difficulty: [] };
        document.querySelectorAll('[data-group]').forEach(function (fs) {
          fs.querySelectorAll('.item').forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
          syncAll(fs, fs.getAttribute('data-group'));
        });
        apply();
      });
      // スマホでは絞り込みを最初から閉じておく(カードを先に見せる)
      if (window.matchMedia('(max-width: 768px)').matches) {
        document.querySelectorAll('details.filter').forEach(function (d) { d.removeAttribute('open'); });
      }
      apply();
    })();
  </script>
</BaseLayout>
<style>
  .sub { margin: 0; color: rgba(255, 255, 255, .92); font-size: .9rem; }
  .mc-wrap { max-width: 1400px; margin: -26px auto 0; padding: 0 20px 40px; position: relative; z-index: 2; }
  .search { display: flex; gap: 12px; padding: 18px; box-shadow: 0 8px 0 var(--mcshadow); }
  input[type='search'] { flex: 1; min-width: 0; height: 52px; padding: 0 16px; font: inherit; border: 3px solid var(--stone); background: #f5f5f5; color: var(--dark); border-radius: 0; }
  input[type='search']:focus { outline: none; border-color: var(--diamond); background: #fff; }
  .layout { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 28px; margin-top: 36px; align-items: start; }
  .side { display: grid; gap: 22px; }
  .filter { overflow: hidden; }
  .filter summary { list-style: none; cursor: pointer; background: var(--stone); color: #fff; padding: 14px 18px; font-weight: 700; font-size: .95rem; border-bottom: 3px solid var(--dark); display: flex; align-items: center; gap: 8px; user-select: none; }
  .filter summary::-webkit-details-marker { display: none; }
  .filter summary::before { content: '▶'; font-size: .7rem; transition: transform .2s; }
  .filter[open] summary::before { transform: rotate(90deg); }
  .filter:not([open]) summary { border-bottom: 0; }
  .items { padding: 14px; display: grid; gap: 8px; }
  .date { margin: 8px 0 0; font-size: .78rem; color: #666; }
  .item { display: flex; justify-content: space-between; align-items: center; gap: 8px; width: 100%; text-align: left; padding: 11px 14px; background: #f5f5f5; border: 2px solid transparent; font: inherit; font-size: .92rem; color: var(--dark); cursor: pointer; }
  .item:hover { background: var(--light); border-color: var(--stone); }
  .item[aria-pressed='true'] { background: var(--diamond); color: #fff; border-color: var(--dark); font-weight: 700; }
  .n { background: var(--dark); color: #fff; padding: 2px 10px; border-radius: 12px; font-size: .8rem; font-weight: 700; flex-shrink: 0; }
  .item[aria-pressed='true'] .n { background: #fff; color: #1a9fb0; }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 12px 18px; margin-bottom: 24px; font-size: .9rem; }
  #result { margin-right: auto; font-weight: 700; }
  select { height: 38px; padding: 0 8px; font: inherit; border: 2px solid var(--stone); background: #fff; color: var(--dark); border-radius: 0; }
  .reset { border: 0; background: none; color: #1976d2; font: inherit; cursor: pointer; text-decoration: underline; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px 24px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .grid li[hidden] { display: none; }
  .card { display: flex; flex-direction: column; height: 100%; background: #fff; border: 4px solid var(--dark); box-shadow: 0 6px 0 var(--mcshadow); overflow: hidden; color: inherit; text-decoration: none; transition: transform .25s, box-shadow .25s; }
  .card:hover { transform: translateY(-6px); box-shadow: 0 12px 0 var(--mcshadow); }
  .thumb { height: 180px; background: linear-gradient(135deg, var(--grass), #00c853); border-bottom: 4px solid var(--dark); display: grid; place-items: center; font-size: 4rem; overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; }
  h2 { font-size: 1.15rem; font-weight: 700; line-height: 1.4; margin: 0 0 10px; color: var(--dark); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .desc { margin: 0 0 14px; font-size: .92rem; line-height: 1.65; color: #666; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: auto 0 0; }
  .empty { padding: 36px 20px; text-align: center; font-weight: 700; }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; gap: 20px; margin-top: 28px; }
    .side { gap: 14px; }
  }
  @media (max-width: 640px) {
    .mc-wrap { padding: 0 12px 28px; }
    .search { padding: 12px; gap: 8px; }
    .search .mc-btn { padding: 0 14px; }
    input[type='search'] { height: 48px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
