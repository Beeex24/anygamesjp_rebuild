---
interface Props { current: number; total: number; href: (page: number) => string }
const { current, total, href } = Astro.props;
// 現在ページの前後2件＋先頭・末尾を表示
const pages = Array.from({ length: total }, (_, i) => i + 1).filter(
  (p) => p === 1 || p === total || Math.abs(p - current) <= 2,
);
---
{total > 1 && (
  <nav class="pager" aria-label="ページ送り">
    {current > 1 && <a class="step" href={href(current - 1)} rel="prev">‹ 前へ</a>}
    {pages.map((p, i) => (
      <>
        {i > 0 && p - pages[i - 1] > 1 && <span class="gap" aria-hidden="true">…</span>}
        {p === current
          ? <span class="num on" aria-current="page">{p}</span>
          : <a class="num" href={href(p)}>{p}</a>}
      </>
    ))}
    {current < total && <a class="step" href={href(current + 1)} rel="next">次へ ›</a>}
  </nav>
)}
<style>
  .pager { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px; margin: 28px 0; }
  .num, .step { min-width: 40px; height: 40px; padding: 0 12px; display: inline-grid; place-items: center; border: 1px solid var(--line); border-radius: var(--radius); color: var(--text); text-decoration: none; font-size: .9rem; }
  a:hover { border-color: var(--c, var(--accent)); color: var(--c, var(--accent)); }
  .on { background: var(--c, var(--accent)); border-color: var(--c, var(--accent)); color: #fff; font-weight: 700; }
  .gap { color: var(--text-sub); }
</style>
