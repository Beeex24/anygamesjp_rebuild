---
/** 画像圧縮ツールのUI。ロジックは src/lib/image/ に分離。 */
import ImageDropzone from './ImageDropzone.astro';
import ImageCompare from './ImageCompare.astro';
import ImageBatch from './ImageBatch.astro';
---
<div class="tool" id="compressor">
  <p class="privacy">🔒 画像はサーバーへアップロードされず、お使いのブラウザ上で処理されます。</p>

  <section class="panel" aria-labelledby="step-input" id="input-panel">
    <h2 id="step-input" class="sr-only">画像を選択</h2>
    <ImageDropzone multiple />

    <details class="adv">
      <summary>詳細設定</summary>
      <div class="adv-grid">
        <label>目標サイズ
          <select id="opt-target">
            <option value="">指定しない(おまかせ)</option>
            <option value="102400">100KB 以下</option>
            <option value="204800">200KB 以下</option>
            <option value="307200">300KB 以下</option>
            <option value="512000">500KB 以下</option>
            <option value="1048576">1MB 以下</option>
          </select>
        </label>
        <label>長辺の最大サイズ
          <select id="opt-edge">
            <option value="">そのまま</option>
            <option value="3840">3840px</option>
            <option value="1920">1920px</option>
            <option value="1280">1280px</option>
          </select>
        </label>
        <label>出力形式
          <select id="opt-format">
            <option value="auto">自動で最適なものを選ぶ</option>
            <option value="jpeg">JPEG</option>
            <option value="webp">WebP</option>
            <option value="avif">AVIF(最小・処理が遅め)</option>
          </select>
        </label>
      </div>
    </details>

    <button type="button" class="btn go" id="run" disabled>Smart Optimize</button>
    <p class="status" id="status" role="status" aria-live="polite"></p>
    <p class="error" id="error" role="alert" hidden></p>
  </section>

  <ImageCompare />

  <ImageBatch />
</div>

<style>
  .tool { max-width: var(--prose); margin: 0 auto; padding: 8px 0 24px; }
  .privacy { background: var(--accent-soft); border-radius: var(--radius); padding: 10px 14px; font-size: .875rem; margin: 0 0 16px; }
  .adv { margin: 16px 0; border: 1px solid var(--line); border-radius: var(--radius); padding: 0 14px; }
  .adv summary { cursor: pointer; padding: 14px 0; font-weight: 700; min-height: 44px; }
  .adv-grid { display: grid; gap: 14px; padding: 0 0 16px; }
  .adv-grid label { display: grid; gap: 6px; font-size: .9rem; }
  select { min-height: 48px; font: inherit; padding: 0 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--text); }
  .go { width: 100%; font-size: 1.05rem; }
  .status { min-height: 1.5em; margin: 10px 0 0; color: var(--text-sub); font-size: .9rem; }
    .error { margin: 10px 0 0; padding: 10px 14px; border-radius: var(--radius); border: 1px solid var(--danger); color: var(--danger); }
</style>

<script>
  import { runCompress, formatBytes } from '../../lib/image/client';
  import type { CompressOptions, OutFormat } from '../../lib/image/compress';
  import { runBatch, initBatchReset, limitFiles } from '../../lib/image/batch';
  import { $, clearError, describeSizeChange, initCompareReset, initDropzoneMulti, showCompare, showError, showFileName } from '../../lib/image/ui';

  const runBtn = $<HTMLButtonElement>('run');
  const statusEl = $('status');
  let files: File[] = [];

  function readOptions(): CompressOptions {
    const t = $<HTMLSelectElement>('opt-target').value;
    const e = $<HTMLSelectElement>('opt-edge').value;
    const f = $<HTMLSelectElement>('opt-format').value;
    const format: OutFormat = f === 'jpeg' || f === 'webp' || f === 'avif' ? f : 'auto';
    return { format, targetBytes: t ? Number(t) : null, maxEdge: e ? Number(e) : null };
  }

  initDropzoneMulti((picked) => {
    clearError();
    statusEl.textContent = '';
    if (picked.length === 0) return;
    files = limitFiles(picked);
    showFileName(files);
    runBtn.disabled = false;
  });

  async function runSingle(file: File) {
    const r = await runCompress(file, readOptions(), (m) => { statusEl.textContent = m; });
    statusEl.textContent = '';
    const summary = r.keptOriginal ? 'これ以上は小さくできませんでした' : describeSizeChange(file.size, r.blob.size);
    showCompare(file, {
      ...r,
      afterExtra: r.quality === null ? '' : `品質 ${Math.round(r.quality * 100)}`,
      summary,
      fileSuffix: 'anygames',
    });
  }

  runBtn.addEventListener('click', async () => {
    if (files.length === 0) return;
    const list = files;
    clearError();
    runBtn.disabled = true;
    try {
      if (list.length === 1) await runSingle(list[0]);
      else {
        const options = readOptions();
        await runBatch(list, async (file, onProgress) => {
          const r = await runCompress(file, options, onProgress);
          return { blob: r.blob, mime: r.mime, suffix: 'anygames', kept: r.keptOriginal };
        }, statusEl);
      }
    } catch (err) {
      statusEl.textContent = '';
      showError(err instanceof Error ? err.message : '処理中に問題が発生しました。もう一度お試しください。');
    } finally {
      runBtn.disabled = files.length === 0;
    }
  });

  initCompareReset(() => { files = []; runBtn.disabled = true; });
  initBatchReset(statusEl, () => { files = []; runBtn.disabled = true; });
</script>
