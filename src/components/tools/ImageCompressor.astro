---
/** 画像圧縮ツールのUI。ロジックは src/lib/image/ に分離。 */
import ImageDropzone from './ImageDropzone.astro';
import ImageCompare from './ImageCompare.astro';
---
<div class="tool" id="compressor">
  <p class="privacy">🔒 画像はサーバーへアップロードされず、お使いのブラウザ上で処理されます。</p>

  <section class="panel" aria-labelledby="step-input" id="input-panel">
    <h2 id="step-input" class="sr-only">画像を選択</h2>
    <ImageDropzone multiple />

    <details class="adv">
      <summary>詳細設定</summary>
      <div class="adv-grid">
        <label>目標サイズ
          <select id="opt-target">
            <option value="">指定しない(おまかせ)</option>
            <option value="102400">100KB 以下</option>
            <option value="204800">200KB 以下</option>
            <option value="307200">300KB 以下</option>
            <option value="512000">500KB 以下</option>
            <option value="1048576">1MB 以下</option>
          </select>
        </label>
        <label>長辺の最大サイズ
          <select id="opt-edge">
            <option value="">そのまま</option>
            <option value="3840">3840px</option>
            <option value="1920">1920px</option>
            <option value="1280">1280px</option>
          </select>
        </label>
        <label>出力形式
          <select id="opt-format">
            <option value="auto">自動で最適なものを選ぶ</option>
            <option value="jpeg">JPEG</option>
            <option value="webp">WebP</option>
            <option value="avif">AVIF(最小・処理が遅め)</option>
          </select>
        </label>
      </div>
    </details>

    <button type="button" class="btn go" id="run" disabled>Smart Optimize</button>
    <p class="status" id="status" role="status" aria-live="polite"></p>
    <p class="error" id="error" role="alert" hidden></p>
  </section>

  <ImageCompare />

  <section class="batch" id="batch" aria-labelledby="batch-title" hidden>
    <h2 id="batch-title" class="section-title">結果</h2>
    <p class="saved" id="batch-summary"></p>
    <ul class="rows" id="batch-rows"></ul>
    <div class="actions">
      <a class="btn" id="zip" href="#" download="anygames-images.zip">すべてZIPで保存</a>
      <button type="button" class="btn btn-sub" id="batch-reset">別の画像を選ぶ</button>
    </div>
  </section>
</div>

<style>
  .tool { max-width: var(--prose); margin: 0 auto; padding: 8px 0 24px; }
  .privacy { background: var(--accent-soft); border-radius: var(--radius); padding: 10px 14px; font-size: .875rem; margin: 0 0 16px; }
  .adv { margin: 16px 0; border: 1px solid var(--line); border-radius: var(--radius); padding: 0 14px; }
  .adv summary { cursor: pointer; padding: 14px 0; font-weight: 700; min-height: 44px; }
  .adv-grid { display: grid; gap: 14px; padding: 0 0 16px; }
  .adv-grid label { display: grid; gap: 6px; font-size: .9rem; }
  select { min-height: 48px; font: inherit; padding: 0 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--text); }
  .go { width: 100%; font-size: 1.05rem; }
  .status { min-height: 1.5em; margin: 10px 0 0; color: var(--text-sub); font-size: .9rem; }
  .batch { scroll-margin-top: 72px; }
  .rows { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 8px; }
  .rows li { display: grid; grid-template-columns: 56px 1fr auto; gap: 4px 12px; align-items: center; padding: 8px 12px 8px 8px; border: 1px solid var(--line); border-radius: var(--radius); }
  .rows img { width: 56px; height: 56px; object-fit: cover; border-radius: 6px; background: var(--bg-soft); }
  .rows .name { font-size: .85rem; font-weight: 700; word-break: break-all; }
  .rows .sub { font-size: .78rem; color: var(--text-sub); }
  .rows .fail { color: var(--danger); }
  .rows a { font-size: .85rem; white-space: nowrap; }
  .actions { display: grid; gap: 10px; margin-top: 16px; }
  @media (min-width: 640px) { .actions { grid-template-columns: 1fr 1fr; } }
  .error { margin: 10px 0 0; padding: 10px 14px; border-radius: var(--radius); border: 1px solid var(--danger); color: var(--danger); }
</style>

<script>
  import { runCompress, formatBytes, buildFileName } from '../../lib/image/client';
  import type { CompressOptions, OutFormat } from '../../lib/image/compress';
  import { buildZip, uniqueName } from '../../lib/image/zip';
  import { $, clearError, describeSizeChange, initCompareReset, initDropzoneMulti, revokeUrls, showCompare, showError, showFileName, trackUrl } from '../../lib/image/ui';

  const MAX_FILES = 30;
  const runBtn = $<HTMLButtonElement>('run');
  const statusEl = $('status');
  let files: File[] = [];

  function readOptions(): CompressOptions {
    const t = $<HTMLSelectElement>('opt-target').value;
    const e = $<HTMLSelectElement>('opt-edge').value;
    const f = $<HTMLSelectElement>('opt-format').value;
    const format: OutFormat = f === 'jpeg' || f === 'webp' || f === 'avif' ? f : 'auto';
    return { format, targetBytes: t ? Number(t) : null, maxEdge: e ? Number(e) : null };
  }

  initDropzoneMulti((picked) => {
    clearError();
    statusEl.textContent = '';
    if (picked.length === 0) return;
    if (picked.length > MAX_FILES) {
      showError(`一度に処理できるのは ${MAX_FILES} 枚までです。先頭の ${MAX_FILES} 枚を選択しました。`);
      picked = picked.slice(0, MAX_FILES);
    }
    files = picked;
    showFileName(files);
    runBtn.disabled = false;
  });

  async function runSingle(file: File) {
    const r = await runCompress(file, readOptions(), (m) => { statusEl.textContent = m; });
    statusEl.textContent = '';
    const summary = r.keptOriginal ? 'これ以上は小さくできませんでした' : describeSizeChange(file.size, r.blob.size);
    showCompare(file, {
      ...r,
      afterExtra: r.quality === null ? '' : `品質 ${Math.round(r.quality * 100)}`,
      summary,
      fileSuffix: 'anygames',
    });
  }

  async function runBatch(list: File[]) {
    const options = readOptions();
    const rows = $('batch-rows');
    rows.replaceChildren();
    revokeUrls();
    const done: { name: string; blob: Blob }[] = [];
    const used = new Set<string>();
    let before = 0;
    let after = 0;
    for (let i = 0; i < list.length; i++) {
      const file = list[i];
      const prefix = `(${i + 1}/${list.length}) `;
      const li = document.createElement('li');
      const thumb = document.createElement('img');
      thumb.alt = '';
      thumb.src = trackUrl(file);
      const info = document.createElement('div');
      const name = document.createElement('div');
      name.className = 'name';
      name.textContent = file.name;
      const sub = document.createElement('div');
      sub.className = 'sub';
      info.append(name, sub);
      li.append(thumb, info);
      rows.append(li);
      try {
        const r = await runCompress(file, options, (m) => { statusEl.textContent = prefix + m; });
        const outName = uniqueName(buildFileName(file.name, r.mime, 'anygames'), used);
        done.push({ name: outName, blob: r.blob });
        before += file.size;
        after += r.blob.size;
        sub.textContent = `${formatBytes(file.size)} → ${formatBytes(r.blob.size)}(${r.keptOriginal ? '元のまま' : describeSizeChange(file.size, r.blob.size)})`;
        const a = document.createElement('a');
        a.href = trackUrl(r.blob);
        a.download = outName;
        a.textContent = '保存';
        li.append(a);
      } catch (err) {
        sub.textContent = err instanceof Error ? err.message : '処理できませんでした。';
        sub.classList.add('fail');
      }
    }
    statusEl.textContent = '';
    if (done.length === 0) {
      showError('処理できる画像がありませんでした。');
      return;
    }
    $('batch-summary').textContent = `${done.length}枚を処理しました(合計 ${formatBytes(before)} → ${formatBytes(after)}・${describeSizeChange(before, after)})`;
    const zip = $<HTMLAnchorElement>('zip');
    zip.hidden = done.length < 2;
    if (done.length >= 2) zip.href = trackUrl(await buildZip(done));
    $('input-panel').hidden = true;
    $('batch').hidden = false;
    $('batch').scrollIntoView({ block: 'start' });
  }

  runBtn.addEventListener('click', async () => {
    if (files.length === 0) return;
    const list = files;
    clearError();
    runBtn.disabled = true;
    try {
      if (list.length === 1) await runSingle(list[0]);
      else await runBatch(list);
    } catch (err) {
      statusEl.textContent = '';
      showError(err instanceof Error ? err.message : '処理中に問題が発生しました。もう一度お試しください。');
    } finally {
      runBtn.disabled = files.length === 0;
    }
  });

  initCompareReset(() => { files = []; runBtn.disabled = true; });
  $('batch-reset').addEventListener('click', () => {
    revokeUrls();
    $<HTMLInputElement>('file').value = '';
    $('file-name').hidden = true;
    $('batch').hidden = true;
    $('input-panel').hidden = false;
    statusEl.textContent = '';
    clearError();
    files = [];
    runBtn.disabled = true;
  });
</script>
