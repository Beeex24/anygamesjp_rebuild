---
/** 画像ツール共通: BEFORE / AFTER の比較スライダーと結果表示。idは src/lib/image/ui.ts と対応。 */
---
<section class="result" id="result" aria-labelledby="step-result" hidden>
  <h2 id="step-result" class="section-title">結果</h2>
  <div class="slider" id="slider" style="--pos: 50%">
    <img id="img-after" alt="変更後の画像" />
    <img id="img-before" alt="変更前の画像" class="before" />
    <span class="tagl">BEFORE</span><span class="tagr">AFTER</span>
    <span class="handle" aria-hidden="true"></span>
    <input type="range" id="slider-range" min="0" max="100" value="50" aria-label="変更前と変更後の比較位置" />
  </div>
  <dl class="metas">
    <div><dt>BEFORE</dt><dd id="meta-before"></dd></div>
    <div><dt>AFTER</dt><dd id="meta-after"></dd></div>
  </dl>
  <p class="saved" id="saved"></p>
  <ul class="notes" id="notes"></ul>
  <div class="actions">
    <a class="btn" id="download" href="#" download>画像を保存</a>
    <button type="button" class="btn btn-sub" id="reset">別の画像を選ぶ</button>
  </div>
</section>
<style>
  .result { scroll-margin-top: 72px; }
  .slider { position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: repeating-conic-gradient(#f0f0f0 0 25%, #fff 0 50%) 0 / 16px 16px; touch-action: pan-y; }
  .slider img { display: block; width: 100%; max-height: 480px; object-fit: contain; }
  .slider .before { position: absolute; inset: 0; height: 100%; max-height: none; clip-path: inset(0 calc(100% - var(--pos)) 0 0); background: repeating-conic-gradient(#f0f0f0 0 25%, #fff 0 50%) 0 / 16px 16px; }
  .slider input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 3px; margin-left: -1.5px; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.35); pointer-events: none; }
  .handle::after { content: '↔'; position: absolute; top: 50%; left: 50%; width: 36px; height: 36px; margin: -18px 0 0 -18px; display: grid; place-items: center; border-radius: 50%; background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,.4); font-size: 1rem; }
  .tagl, .tagr { position: absolute; top: 8px; padding: 2px 8px; border-radius: 4px; background: rgba(0,0,0,.6); color: #fff; font-size: .7rem; font-weight: 800; letter-spacing: .08em; pointer-events: none; }
  .tagl { left: 8px; } .tagr { right: 8px; }
  .slider:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .metas { display: grid; gap: 8px; margin: 12px 0 0; font-size: .85rem; }
  .metas div { display: flex; gap: 10px; }
  .metas dt { font-weight: 800; font-size: .75rem; letter-spacing: .08em; min-width: 56px; padding-top: 1px; }
  .metas dd { margin: 0; color: var(--text-sub); }
  .saved { font-size: 1.1rem; font-weight: 800; margin: 16px 0 4px; }
  .notes { color: var(--text-sub); font-size: .875rem; padding-left: 1.2em; }
  .actions { display: grid; gap: 10px; margin-top: 16px; }
  @media (min-width: 640px) { .actions { grid-template-columns: 1fr 1fr; } }
</style>
