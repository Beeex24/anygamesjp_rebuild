---
/** 画像リサイズ(拡大・縮小)ツールのUI。ロジックは src/lib/image/resize.ts。 */
import ImageDropzone from './ImageDropzone.astro';
import ImageCompare from './ImageCompare.astro';
import ImageBatch from './ImageBatch.astro';
---
<div class="tool" id="resizer">
  <p class="privacy">🔒 画像はサーバーへアップロードされず、お使いのブラウザ上で処理されます。</p>

  <section class="panel" aria-labelledby="step-input" id="input-panel">
    <h2 id="step-input" class="sr-only">画像を選択</h2>
    <ImageDropzone multiple />

    <fieldset class="method">
      <legend>サイズの決め方</legend>
      <div class="tabs" role="radiogroup" aria-label="サイズの決め方">
        <label><input type="radio" name="method" value="edge" checked /><span>長辺で指定</span></label>
        <label><input type="radio" name="method" value="percent" /><span>倍率で指定</span></label>
        <label><input type="radio" name="method" value="size" /><span>幅・高さで指定</span></label>
      </div>

      <div class="pane" data-pane="edge">
        <div class="chips" role="group" aria-label="よく使う長辺">
          <button type="button" class="chip" data-edge="3840">3840px</button>
          <button type="button" class="chip" data-edge="1920">1920px</button>
          <button type="button" class="chip" data-edge="1280">1280px</button>
          <button type="button" class="chip" data-edge="800">800px</button>
        </div>
        <label>長辺(px)<input type="number" id="in-edge" inputmode="numeric" min="1" max="16384" value="1920" /></label>
      </div>

      <div class="pane" data-pane="percent" hidden>
        <div class="chips" role="group" aria-label="よく使う倍率">
          <button type="button" class="chip" data-percent="25">25%</button>
          <button type="button" class="chip" data-percent="50">50%</button>
          <button type="button" class="chip" data-percent="200">200%</button>
        </div>
        <label>倍率(%)<input type="number" id="in-percent" inputmode="decimal" min="1" max="1000" value="50" /></label>
      </div>

      <div class="pane" data-pane="size" hidden>
        <div class="two">
          <label>幅(px)<input type="number" id="in-width" inputmode="numeric" min="1" max="16384" placeholder="例 1280" /></label>
          <label>高さ(px)<input type="number" id="in-height" inputmode="numeric" min="1" max="16384" placeholder="例 720" /></label>
        </div>
        <label class="check"><input type="checkbox" id="in-ratio" checked />縦横比を保つ</label>
      </div>
    </fieldset>

    <details class="adv">
      <summary>詳細設定</summary>
      <div class="adv-grid">
        <label>保存形式
          <select id="opt-format">
            <option value="same">元の形式のまま</option>
            <option value="jpeg">JPEG</option>
            <option value="webp">WebP</option>
            <option value="png">PNG</option>
          </select>
        </label>
      </div>
    </details>

    <button type="button" class="btn go" id="run" disabled>サイズを変更する</button>
    <p class="status" id="status" role="status" aria-live="polite"></p>
    <p class="error" id="error" role="alert" hidden></p>
  </section>

  <ImageCompare />
  <ImageBatch />
</div>

<style>
  .tool { max-width: var(--prose); margin: 0 auto; padding: 8px 0 24px; }
  .privacy { background: var(--accent-soft); border-radius: var(--radius); padding: 10px 14px; font-size: .875rem; margin: 0 0 16px; }
  .method { border: 0; padding: 0; margin: 20px 0 0; }
  legend { font-weight: 700; padding: 0; margin-bottom: 8px; }
  .tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .tabs label { position: relative; }
  .tabs input { position: absolute; opacity: 0; inset: 0; }
  .tabs span { display: grid; place-items: center; min-height: 48px; padding: 0 6px; text-align: center; font-size: .875rem; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); cursor: pointer; }
  .tabs input:checked + span { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); font-weight: 700; }
  .tabs input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pane { margin-top: 14px; display: grid; gap: 12px; }
  .pane[hidden] { display: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { min-height: 44px; padding: 0 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); font: inherit; font-size: .875rem; cursor: pointer; color: var(--text); }
  .chip:hover { border-color: var(--accent); }
  label { display: grid; gap: 6px; font-size: .9rem; }
  input[type='number'], select { min-height: 48px; font: inherit; padding: 0 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--text); width: 100%; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .check { display: flex; align-items: center; gap: 10px; min-height: 44px; }
  .check input { width: 22px; height: 22px; }
  .adv { margin: 16px 0; border: 1px solid var(--line); border-radius: var(--radius); padding: 0 14px; }
  .adv summary { cursor: pointer; padding: 14px 0; font-weight: 700; min-height: 44px; }
  .adv-grid { display: grid; gap: 14px; padding: 0 0 16px; }
  .go { width: 100%; font-size: 1.05rem; }
  .status { min-height: 1.5em; margin: 10px 0 0; color: var(--text-sub); font-size: .9rem; }
  .error { margin: 10px 0 0; padding: 10px 14px; border-radius: var(--radius); border: 1px solid var(--danger); color: var(--danger); }
</style>

<script>
  import { runResize } from '../../lib/image/client';
  import { runBatch, initBatchReset, limitFiles } from '../../lib/image/batch';
  import type { ResizeFormat, ResizeMethod, ResizeOptions } from '../../lib/image/resize';
  import { $, clearError, initCompareReset, initDropzoneMulti, showCompare, showError, showFileName } from '../../lib/image/ui';

  const runBtn = $<HTMLButtonElement>('run');
  const statusEl = $('status');
  let files: File[] = [];

  const num = (id: string): number | null => {
    const v = $<HTMLInputElement>(id).value.trim();
    return v === '' ? null : Number(v);
  };
  const method = (): ResizeMethod => {
    const v = document.querySelector<HTMLInputElement>('input[name="method"]:checked')?.value;
    return v === 'percent' || v === 'size' ? v : 'edge';
  };

  function syncPanes() {
    const m = method();
    document.querySelectorAll<HTMLElement>('.pane').forEach((p) => { p.hidden = p.dataset.pane !== m; });
  }
  document.querySelectorAll('input[name="method"]').forEach((r) => r.addEventListener('change', syncPanes));

  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) =>
    c.addEventListener('click', () => {
      if (c.dataset.edge) $<HTMLInputElement>('in-edge').value = c.dataset.edge;
      if (c.dataset.percent) $<HTMLInputElement>('in-percent').value = c.dataset.percent;
    }));

  function readOptions(): ResizeOptions {
    const f = $<HTMLSelectElement>('opt-format').value;
    const format: ResizeFormat = f === 'jpeg' || f === 'webp' || f === 'png' ? f : 'same';
    return {
      method: method(),
      edge: num('in-edge'),
      width: num('in-width'),
      height: num('in-height'),
      keepRatio: $<HTMLInputElement>('in-ratio').checked,
      percent: num('in-percent'),
      format,
    };
  }

  initDropzoneMulti((picked) => {
    clearError();
    statusEl.textContent = '';
    if (picked.length === 0) return;
    files = limitFiles(picked);
    showFileName(files);
    runBtn.disabled = false;
  });

  async function runSingle(file: File) {
    const r = await runResize(file, readOptions(), (m) => { statusEl.textContent = m; });
    statusEl.textContent = '';
    showCompare(file, {
      ...r,
      summary: `${r.originalWidth}×${r.originalHeight}px → ${r.width}×${r.height}px に変更しました`,
      fileSuffix: `${r.width}x${r.height}`,
    });
  }

  runBtn.addEventListener('click', async () => {
    if (files.length === 0) return;
    const list = files;
    clearError();
    runBtn.disabled = true;
    try {
      if (list.length === 1) await runSingle(list[0]);
      else {
        const options = readOptions();
        await runBatch(list, async (file, onProgress) => {
          const r = await runResize(file, options, onProgress);
          return { blob: r.blob, mime: r.mime, suffix: `${r.width}x${r.height}`, extra: `${r.originalWidth}×${r.originalHeight} → ${r.width}×${r.height}px` };
        }, statusEl, 'サイズ変更のため');
      }
    } catch (err) {
      statusEl.textContent = '';
      showError(err instanceof Error ? err.message : '処理中に問題が発生しました。もう一度お試しください。');
    } finally {
      runBtn.disabled = files.length === 0;
    }
  });

  initCompareReset(() => { files = []; runBtn.disabled = true; });
  initBatchReset(statusEl, () => { files = []; runBtn.disabled = true; });
</script>
