---
/** 画像ツール共通: ファイル選択エリア。idは src/lib/image/ui.ts と対応。 */
interface Props { multiple?: boolean }
const { multiple = false } = Astro.props;
---
<label class="drop" id="drop">
  <input type="file" id="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple={multiple} />
  <span class="drop-main">{multiple ? '画像を選択(複数OK)、またはここにドラッグ' : '画像を選択、またはここにドラッグ'}</span>
  <span class="drop-sub">JPEG / PNG / WebP / AVIF ・ 40MBまで</span>
</label>
<p class="file-name" id="file-name" hidden></p>
<style>
  .drop { display: grid; gap: 4px; place-items: center; text-align: center; min-height: 168px; padding: 20px; border: 2px dashed var(--line); border-radius: var(--radius); background: var(--bg-soft); cursor: pointer; }
  .drop:hover, .drop:global(.over) { border-color: var(--accent); background: var(--accent-soft); }
  .drop input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .drop:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .drop-main { font-weight: 700; }
  .drop-sub { font-size: .8125rem; color: var(--text-sub); }
  .file-name { margin: 10px 0 0; font-size: .9rem; word-break: break-all; }
</style>
