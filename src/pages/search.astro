---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts, postUrl, sectionLabel } from '../lib/site';

const posts = await getAllPosts();
// クライアントへ渡す検索用データ（本文は含めない）
const index = posts.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  heroImage: p.data.heroImage ?? '',
  tags: ('tags' in p.data ? p.data.tags : undefined) ?? [],
  path: postUrl(p),
  section: sectionLabel(p.collection),
}));
---
<BaseLayout title="サイト内検索" description="ANYGAMESの記事をキーワードで検索できます。" noindex>
  <div class="container">
    <h1>サイト内検索</h1>
    <form class="form" action="/search/" method="get" role="search">
      <label class="sr-only" for="q">キーワード</label>
      <input id="q" name="q" type="search" placeholder="例: VALORANT、MOD、キーボード" autocomplete="off" />
      <button class="btn" type="submit">検索</button>
    </form>
    <p id="status" class="status" aria-live="polite"></p>
    <ul id="results" class="results"></ul>
  </div>
  <script is:inline define:vars={{ index }}>
    (function () {
      // 略称・表記ゆれ → 記事内で使われる正式な語
      var ALIASES = [
        [['ヴァロ', 'バロ', 'valo', 'vct'], 'valorant'],
        [['ow2', 'オバウォ', 'オーバウォ'], 'overwatch'],
        [['エペ', 'えぺ'], 'apex'],
        [['マイクラ', 'まいくら'], 'minecraft'],
        [['bf6'], 'battlefield'],
        [['gta'], 'grand theft auto']
      ];
      var q = (new URLSearchParams(location.search).get('q') || '').toLowerCase().trim();
      var input = document.getElementById('q');
      var status = document.getElementById('status');
      var list = document.getElementById('results');
      input.value = q;
      if (!q) { status.textContent = 'キーワードを入力してください。'; return; }
      var terms = [q];
      ALIASES.forEach(function (a) { if (a[0].some(function (w) { return q.indexOf(w) !== -1; })) terms.push(a[1]); });
      var hits = index.filter(function (p) {
        var hay = (p.title + ' ' + p.description + ' ' + p.tags.join(' ')).toLowerCase();
        return terms.some(function (t) { return hay.indexOf(t) !== -1; });
      });
      status.textContent = '「' + q + '」の検索結果: ' + hits.length + '件';
      hits.slice(0, 60).forEach(function (p) {
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = p.path;
        var tag = document.createElement('span');
        tag.className = 'tag'; tag.textContent = p.section;
        var h = document.createElement('strong'); h.textContent = p.title;
        var d = document.createElement('span'); d.className = 'desc'; d.textContent = p.description;
        a.append(tag, h, d); li.append(a); list.append(li);
      });
      if (hits.length === 0) status.textContent += ' 別のキーワードをお試しください。';
    })();
  </script>
</BaseLayout>
<style>
  h1 { font-size: 1.6rem; margin: 20px 0 12px; }
  .form { display: flex; gap: 8px; max-width: 560px; }
  .form input { flex: 1; min-width: 0; height: 44px; padding: 0 14px; font: inherit; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); color: var(--text); }
  .status { color: var(--text-sub); margin: 14px 0; }
  .results { list-style: none; margin: 0 0 40px; padding: 0; display: grid; gap: 10px; max-width: 760px; }
  .results :global(a) { display: grid; gap: 4px; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius); color: inherit; text-decoration: none; }
  .results :global(a:hover) { border-color: var(--accent); }
  .results :global(.tag) { justify-self: start; font-size: .72rem; padding: 1px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-weight: 700; }
  .results :global(.desc) { font-size: .85rem; color: var(--text-sub); }
</style>
