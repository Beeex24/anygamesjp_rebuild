---
import PostListPage from '../../components/PostListPage.astro';
import { getCollection } from 'astro:content';
import { pageRoutes, PAGE_SIZE, type ListPageProps } from '../../lib/list';

// 既存URL: /all/1/ 〜（ゲーム・モバイル・ガジェットの新着、13件/ページ）
export async function getStaticPaths() {
  const all = [
    ...(await getCollection('blog')),
    ...(await getCollection('mobileblog')),
    ...(await getCollection('device')),
  ];
  return pageRoutes(all, PAGE_SIZE);
}
const p = Astro.props as ListPageProps;
---
<PostListPage {...p} heading="新着記事" lead="ゲーム・モバイル・ガジェットの記事を新しい順に表示しています。"
  basePath="/all/1/" pageHref={(n: number) => `/all/${n}/`}
  breadcrumb={[{ name: 'ホーム', href: '/' }, { name: '新着記事' }]} />
