---
// src/pages/minecraft_mod/index.astro
// /minecraft_mod にアクセスした際に /minecraft_mod/1 にリダイレクト
import { getCollection } from "astro:content";

// minecraft_mod_blogコレクションから記事を取得
const modPosts = await getCollection("minecraft_mod_blog");

// 記事が存在する場合は1ページ目にリダイレクト
if (modPosts.length > 0) {
  return Astro.redirect("/minecraft_mod_info/1");
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>マインクラフトMOD一覧</title>
    <meta http-equiv="refresh" content="0; url=/minecraft_mod_info/1" />
  </head>
  <body>
    <p>リダイレクト中...</p>
  </body>
</html>