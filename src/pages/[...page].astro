---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const mobilePosts = (await getCollection("mobileblog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const devicePosts = (await getCollection("device")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const minecraftblog = (await getCollection("minecraft_blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const minecraftmods = (await getCollection("minecraft_mod_blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allPosts = [...posts, ...mobilePosts, ...devicePosts, ...minecraftblog, ...minecraftmods].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);


import "swiper/swiper-bundle.css";



export async function getStaticPaths() {
 
  return [
    { params: { page: undefined } },  // ルートページ
    { params: { page: 'blog' } },     // /blog
    { params: { page: 'device' } },   // /device
    { params: { page: 'mobileblog' } },    // /mobileblog
    { params: { page: 'minecraft_blog' } }, // /minecraft_blog
    { params: { page: 'minecraft_mod_blog' } } // /minecraft_mod_blog
  ];
}

// SSRを有効にする場合は以下を追加
export const prerender = true;
---

<!-- ページのコンテンツをここに記述 -->

<!doctype html>
<html lang="ja">
  <head>
   <!-- Swiper.js のスタイルとスクリプト -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/swiper/swiper-bundle.min.css,"
    />
    <script src="https://unpkg.com/swiper/swiper-bundle.min.js" defer></script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Swiperライブラリが読み込まれるまで待機
        function initSwiper() {
          // TypeScript型エラー回避のためanyとして扱う
          const SwiperClass = (window as any).Swiper;
          if (typeof SwiperClass !== 'undefined') {
            new SwiperClass(".swiper-container", {
              loop: true, // ループを有効化
              autoplay: {
                delay: 4000, // スライド間隔
                disableOnInteraction: false, // ユーザー操作後も自動再生を継続
              },
              speed: 800, // アニメーション速度
              navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
              },
              pagination: {
                el: ".swiper-pagination",
                clickable: true,
              },
              slidesPerView: 1, // デフォルトで1スライドを表示
              spaceBetween: 20, // スライド間の余白
              breakpoints: {
                768: {
                  slidesPerView: 2, // 中画面では2スライドを表示
                  spaceBetween: 20, // スライド間の余白
                },
                1024: {
                  slidesPerView: 5, // 大画面では3スライドを表示
                  spaceBetween: 30, // スライド間の余白
                },
              },
            });
          } else {
            // Swiperがまだ読み込まれていない場合、少し待ってから再試行
            setTimeout(initSwiper, 100);
          }
        }
        
        initSwiper();
      });
    </script>
    <BaseHead 
      title={SITE_TITLE} 
      description={SITE_DESCRIPTION} 
      image="/placeholder-image.jpg"
    />
    <style>
      /* スライダーセクションのスタイル */
      .blog-slider-section {
        padding: 2rem;
        background-color: #f9f9f9;
        border-radius: 8px;
        margin: 3.5rem auto;
        max-width: 100vw;
        width: 100vw;
        position: relative;
        box-sizing: border-box;
      }

      .blog-slider-section h2 {
        font-size: 1.8rem;
        text-align: center;
        margin-bottom: 1rem;
        color: #333;
      }

      .swiper-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        overflow: hidden; /* 画面外に出る部分を隠す */
      }

      .swiper,
      .swiper-wrapper {
        position: relative;
        z-index: 1;
      }

      .swiper-wrapper {
        box-sizing: content-box;
        display: flex;
        height: 100%;
        width: 100%;
      }

      .swiper-slide {
        display: flex;
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
        flex-shrink: 0;
        height: 100%;
        width: 100%;
      }

      .blog-card {
        width: 95%;
        max-width: 350px;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        text-decoration: none;
        color: inherit;
        margin: 0 10px;
        transition:
          box-shadow 0.3s,
          transform 0.3s;
      }

      .blog-card:hover {
        transform: translateY(-10px) scale(1.03);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
      }

      .blog-card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
      }

      .blog-card-content {
        padding: 1rem;
      }

      .blog-card-title {
        font-size: 1.2rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
        color: #222;
      }

      .blog-card-description {
        font-size: 0.9rem;
        color: #555;
        margin-bottom: 1rem;
      }

      .blog-card-date {
        font-size: 0.8rem;
        color: #888;
        text-align: right;
      }

      /* Swiperナビゲーションボタンのカスタマイズ */
      .swiper-button-next,
      .swiper-button-prev {
        background: rgba(0, 0, 0, 0.6);
        color: #fff;
        cursor: pointer;
        height: 48px;
        width: 48px;
        border-radius: 50%;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: background 0.2s;
      }
      .swiper-button-next {
        right: 20px;
        left: auto;
      }
      .swiper-button-prev {
        left: 20px;
        right: auto;
      }
      .swiper-button-next:after,
      .swiper-button-prev:after {
        font-size: 1.6rem;
        font-weight: bold;
      }
      .swiper-button-next:hover,
      .swiper-button-prev:hover {
        background: rgba(0, 0, 0, 0.85);
      }

      /* Swiperページネーション */
      .swiper-pagination {
        position: absolute;
        bottom: 10px;
        left: 0;
        width: 100%;
        text-align: center;
        z-index: 10;
      }
      .swiper-pagination-bullet {
        background: #000;
        opacity: 0.3;
        width: 10px;
        height: 10px;
        margin: 0 4px;
        border-radius: 50%;
        display: inline-block;
        transition: opacity 0.2s;
      }
      .swiper-pagination-bullet-active {
        background: #4781ff;
        opacity: 1;
      }

      @media (max-width: 1024px) {
        .blog-slider-section {
          max-width: 100vw;
          width: 100vw;
        }
        .swiper-container {
          max-width: 98vw;
        }
      }
      @media (max-width: 768px) {
        .blog-slider-section {
          padding: 1rem 0.5rem;
          margin: 2rem 0;
          max-width: 100vw;
          width: 100vw;
        }
        .swiper-container {
          max-width: 100vw;
        }
        .blog-card {
          max-width: 95vw;
          margin: 0 2px;
        }
        .swiper-button-next,
        .swiper-button-prev {
          width: 32px;
          height: 32px;
        }
        .swiper-button-next {
          right: 4px;
        }
        .swiper-button-prev {
          left: 4px;
        }
      }
    </style>
  </head>

  <style>
    @media (max-width: 768px) {
      /* ブログカードの画像サイズ調整 */
      .blog-card img {
        height: 100px; /* 高さをさらに縮小 */
        margin: 0 auto; /* 中央揃え */
      }

      /* ブログカードのタイトルと説明のフォントサイズ調整 */
      .blog-card-title {
        font-size: 0.9rem; /* タイトルのフォントサイズをさらに小さく */
      }

      .blog-card-description {
        font-size: 0.75rem; /* 説明のフォントサイズをさらに小さく */
      }

      /* ブログセクションのグリッド調整 */
      .blog-grid {
        grid-template-columns: 1fr; /* モバイル画面では1列表示 */
        gap: 0.5rem; /* カード間の余白を調整 */
      }

      /* スライダーのボタンサイズ調整 */
      .blog-slider-section .swiper-button-next,
      .blog-slider-section .swiper-button-prev {
        width: 25px; /* ボタンの幅をさらに縮小 */
        height: 25px; /* ボタンの高さをさらに縮小 */
      }

      /* アフィリエイトセクションのグリッド調整 */
      .affiliate-grid {
        grid-template-columns: 1fr; /* モバイル画面では1列表示 */
        gap: 1rem; /* カード間の余白を調整 */
      }

      /* 通知バーのフォントサイズ調整 */
      .notification-bar {
        font-size: 1rem; /* フォントサイズをさらに小さく */
      }

      /* メインタイトルのフォントサイズ調整 */
      main h1 {
        font-size: 1.2rem; /* タイトルのフォントサイズをさらに小さく */
      }

      main p {
        font-size: 0.9rem; /* 説明文のフォントサイズをさらに小さく */
      }

      /* 広告セクションの非表示 */
      .side-ads {
        display: none; /* モバイル画面では非表示 */
      }

      .ad-top-right {
        display: none; /* モバイル画面では非表示 */
      }
    
      {
        box-sizing: border-box;
      }
      html, body {
        overflow-x: hidden !important;
        width: 100% !important;
        max-width: 100vw !important;
      }
    }
  </style>

  <!-- 上部右側ディスプレイ広告 -->
   <head>
   <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4929223237591717"
     crossorigin="anonymous"></script>
  </head>

  <body>
