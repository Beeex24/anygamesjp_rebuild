---
import PostListPage from '../../components/PostListPage.astro';
import { getCollection } from 'astro:content';
import { restRoutes, type ListPageProps } from '../../lib/list';

// 既存URL: /device/ と /device/2/ …（100件/ページ）
export async function getStaticPaths() {
  return restRoutes(await getCollection('device'), 100);
}
const p = Astro.props as ListPageProps;
const href = (n: number) => (n === 1 ? '/device/' : `/device/${n}/`);
---
<PostListPage {...p} heading="ガジェット" lead="ゲーミングデバイス・PC周辺機器のレビューと比較記事の一覧です。" basePath="/device/" pageHref={href} gameFilter={false}
  breadcrumb={[{ name: 'ホーム', href: '/' }, { name: 'ガジェット' }]} />
