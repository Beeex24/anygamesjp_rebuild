---
import PostListPage from '../../../components/PostListPage.astro';
import { getCollection } from 'astro:content';
import { pageRoutes, type ListPageProps } from '../../../lib/list';

// 既存URL: /device/page/N/ （9件/ページ）
export async function getStaticPaths() {
  return pageRoutes(await getCollection('device'), 9);
}
const p = Astro.props as ListPageProps;
const href = (n: number) => `/device/page/${n}/`;
---
<PostListPage {...p} heading="ガジェット" lead="ゲーミングデバイス・PC周辺機器のレビューと比較記事の一覧です。" basePath="/device/" pageHref={href} gameFilter={false}
  breadcrumb={[{ name: 'ホーム', href: '/' }, { name: 'ガジェット', href: '/device/' }, { name: 'ページ一覧' }]} />
