---
import PostListPage from '../../../components/PostListPage.astro';
import { getCollection } from 'astro:content';
import { pageRoutes, type ListPageProps } from '../../../lib/list';

// 既存URL: /blog/page/N/ （9件/ページ）
export async function getStaticPaths() {
  return pageRoutes(await getCollection('blog'), 9);
}
const p = Astro.props as ListPageProps;
const href = (n: number) => `/blog/page/${n}/`;
---
<PostListPage {...p} heading="ゲーム記事" lead="ゲームの新作情報・アップデート・セール情報をまとめています。" basePath="/blog/" pageHref={href} gameFilter={true}
  breadcrumb={[{ name: 'ホーム', href: '/' }, { name: 'ゲーム記事', href: '/blog/' }, { name: 'ページ一覧' }]} />
