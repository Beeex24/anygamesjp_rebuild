---
// src/pages/blog/page/[page].astro
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../../components/FormattedDate.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  const POSTS_PER_PAGE = 9;
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

  const paths = [];
  for (let i = 1; i <= totalPages; i++) {
    const start = (i - 1) * POSTS_PER_PAGE;
    const end = start + POSTS_PER_PAGE;
    
    paths.push({
      params: { page: i.toString() },
      props: {
        posts: posts.slice(start, end),
        currentPage: i,
        totalPages,
        totalPosts: posts.length
      }
    });
  }

  return paths;
}

const { posts, currentPage, totalPages, totalPosts } = Astro.props;
const POSTS_PER_PAGE = 9;

// ページネーション用の計算
const showPages = 5;
let startPage = Math.max(1, currentPage - Math.floor(showPages / 2));
let endPage = Math.min(totalPages, startPage + showPages - 1);

if (endPage - startPage + 1 < showPages) {
  startPage = Math.max(1, endPage - showPages + 1);
}

const pages = [];
for (let i = startPage; i <= endPage; i++) {
  pages.push(i);
}
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead 
      title={`ゲーム記事 - ページ ${currentPage} | ${SITE_TITLE}`} 
      description={SITE_DESCRIPTION} 
      image="/placeholder-image.jpg"
    />
    <style>
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
      }

      .page-header {
        background: rgba(0, 0, 0, 0.1);
        padding: 2rem 0;
        margin-bottom: 3rem;
      }

      .page-header h1 {
        color: white;
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
      }

      .page-info {
        text-align: center;
        color: rgba(255, 255, 255, 0.9);
        font-size: 1.1rem;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      .article-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 2rem;
        margin-bottom: 4rem;
      }

      .article-card {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
      }

      .article-card:hover {
        transform: translateY(-10px) scale(1.02);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
      }

      .article-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        transition: transform 0.6s ease;
      }

      .article-card:hover .article-image {
        transform: scale(1.1);
      }

      .article-content {
        padding: 1.5rem;
      }

      .article-category {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        background: linear-gradient(135deg, #ff6b6b, #ee5a24);
        color: white;
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 20px;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .article-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 0.8rem;
        line-height: 1.4;
        transition: color 0.3s ease;
      }

      .article-card:hover .article-title {
        color: #3498db;
      }

      .article-description {
        color: #7f8c8d;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1rem;
      }

      .article-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #95a5a6;
        font-size: 0.85rem;
      }

      .article-date {
        font-weight: 600;
      }

      .article-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
      }

      .read-more {
        background: linear-gradient(135deg, #3498db, #2980b9);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .read-more:hover {
        background: linear-gradient(135deg, #2980b9, #3498db);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
      }

      /* ページネーションスタイル */
      .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin: 4rem 0;
        padding: 1rem 0;
      }

      .pagination a,
      .pagination span {
        padding: 0.5rem 1rem;
        background: rgba(255, 255, 255, 0.95);
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        color: #333;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.3s ease;
      }

      .pagination a:hover {
        background: #4781ff;
        color: white;
        border-color: #4781ff;
        transform: translateY(-2px);
        box-shadow: 0 2px 8px rgba(71, 129, 255, 0.3);
      }

      .pagination .page-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0;
        font-size: 0.95rem;
      }

      .pagination .current {
        background: #4781ff;
        color: white;
        border-color: #4781ff;
      }

      .pagination .disabled {
        opacity: 0.5;
        cursor: not-allowed;
        background: #f0f0f0;
      }

      .pagination .ellipsis {
        padding: 0.5rem;
        color: #666;
        background: none;
        border: none;
      }

      .back-link {
        display: inline-block;
        margin: 2rem 0;
        padding: 0.8rem 1.5rem;
        background: rgba(255, 255, 255, 0.2);
        color: white;
        text-decoration: none;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
      }

      .back-link:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-2px);
      }

      @media (max-width: 768px) {
        .page-header h1 {
          font-size: 1.8rem;
        }

        .article-grid {
          grid-template-columns: 1fr;
          gap: 1rem;
        }

        .container {
          padding: 0 1rem;
        }

        .article-image {
          height: 160px;
        }

        .article-content {
          padding: 1rem;
        }

        .article-title {
          font-size: 1.1rem;
        }

        .pagination {
          gap: 0.3rem;
        }

        .pagination a,
        .pagination span {
          padding: 0.4rem 0.8rem;
          font-size: 0.85rem;
        }

        .pagination .page-number {
          min-width: 35px;
          height: 35px;
        }

        {
          box-sizing: border-box;
        }
        html, body {
          overflow-x: hidden !important;
          width: 100% !important;
          max-width: 100vw !important;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <div class="page-header">
      <h1>PCゲーム記事</h1>
      <p class="page-info">
        全 {totalPosts} 件中 {(currentPage - 1) * POSTS_PER_PAGE + 1} - {Math.min(currentPage * POSTS_PER_PAGE, totalPosts)} 件を表示
      </p>
    </div>

    <div class="container">
      <a href="/" class="back-link">← ホームに戻る</a>

      <div class="article-grid">
        {
          posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="article-card-link">
              <article class="article-card">
                <img
                  src={post.data.heroImage}
                  alt={post.data.title}
                  class="article-image"
                />
                <div class="article-content">
                  <span class="article-category">PCゲーム</span>
                  <h3 class="article-title">{post.data.title}</h3>
                  <p class="article-description">
                    {post.data.description}
                  </p>
                  <div class="article-meta">
                    <span class="article-date">
                      <FormattedDate date={post.data.pubDate} />
                    </span>
                    <span class="read-more">続きを読む</span>
                  </div>
                </div>
              </article>
            </a>
          ))
        }
      </div>

      <!-- ページネーション -->
      <div class="pagination">
        {currentPage > 1 && (
          <a href={currentPage === 2 ? "/" : `/blog/page/${currentPage - 1}`}>
            ← 前へ
          </a>
        )}
        
        {/* 最初のページ */}
        {startPage > 1 && (
          <>
            <a href="/" class="page-number">1</a>
            {startPage > 2 && <span class="ellipsis">...</span>}
          </>
        )}

        {/* ページ番号 */}
        {pages.map(page => 
          page === currentPage ? (
            <span class="page-number current">{page}</span>
          ) : page === 1 ? (
            <a href="/" class="page-number">{page}</a>
          ) : (
            <a href={`/blog/page/${page}`} class="page-number">{page}</a>
          )
        )}

        {/* 最後のページ */}
        {endPage < totalPages && (
          <>
            {endPage < totalPages - 1 && <span class="ellipsis">...</span>}
            <a href={`/blog/page/${totalPages}`} class="page-number">{totalPages}</a>
          </>
        )}

        {currentPage < totalPages && (
          <a href={`/blog/page/${currentPage + 1}`}>
            次へ →
          </a>
        )}
      </div>
    </div>

    <Footer />
  </body>
</html>