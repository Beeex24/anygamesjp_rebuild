---
import PostListPage from '../../components/PostListPage.astro';
import { getCollection } from 'astro:content';
import { restRoutes, type ListPageProps } from '../../lib/list';

// 既存URL: /blog/ と /blog/2/ …（100件/ページ）
export async function getStaticPaths() {
  return restRoutes(await getCollection('blog'), 100);
}
const p = Astro.props as ListPageProps;
const href = (n: number) => (n === 1 ? '/blog/' : `/blog/${n}/`);
---
<PostListPage {...p} heading="ゲーム" lead="ゲームの新作情報・アップデート・セール情報をまとめています。" basePath="/blog/" pageHref={href} gameFilter={true}
  breadcrumb={[{ name: 'ホーム', href: '/' }, { name: 'ゲーム' }]} />
