---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SECTIONS } from '../lib/site';
import { TOOLS, TOOL_CATEGORIES } from '../lib/tools';

const groups = [
  { title: '記事', links: [{ href: '/', label: 'ホーム' }, ...SECTIONS.map((s) => ({ href: s.path, label: s.label }))] },
  ...Object.entries(TOOL_CATEGORIES).map(([key, label]) => ({
    title: `ツール: ${label}`,
    links: TOOLS.filter((t) => t.category === key).map((t) => ({ href: t.href, label: t.name })),
  })),
  { title: 'サイト情報', links: [
    { href: '/infosite/', label: 'サイトについて' },
    { href: '/Link/', label: 'リンク' },
    { href: '/about/', label: 'お問い合わせ' },
    { href: '/terms/', label: '利用規約' },
    { href: '/policy/', label: 'プライバシーポリシー' },
  ] },
];
---
<BaseLayout title="サイトマップ" description="ANYGAMESの全ページへのリンクをまとめたサイトマップです。"
  breadcrumbs={[{ name: 'ホーム', href: '/' }, { name: 'サイトマップ', href: '/sitemap/' }]}>
  <div class="container">
    <Breadcrumb items={[{ name: 'ホーム', href: '/' }, { name: 'サイトマップ' }]} />
    <h1>サイトマップ</h1>
    <div class="grid">
      {groups.map((g) => (
        <section>
          <h2>{g.title}</h2>
          <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
<style>
  h1 { font-size: 1.6rem; margin: 8px 0 20px; }
  .grid { display: grid; gap: 16px; grid-template-columns: 1fr; padding-bottom: 40px; }
  @media (min-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  section { border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; }
  h2 { font-size: 1rem; margin: 0 0 10px; }
  ul { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  a { color: var(--accent); }
</style>
