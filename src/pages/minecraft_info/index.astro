---
// src/pages/minecraft_info/index.astro
// /minecraft_info にアクセスした際に /minecraft_info/1 にリダイレクト
import { getCollection } from "astro:content";

// minecraft_blogコレクションから記事を取得
const minecraftPosts = await getCollection("minecraft_blog");

// 記事が存在する場合は1ページ目にリダイレクト
if (minecraftPosts.length > 0) {
  return Astro.redirect("/minecraft_info/1");
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>マインクラフト記事一覧</title>
    <meta http-equiv="refresh" content="0; url=/minecraft_info/1" />
  </head>
  <body>
    <p>リダイレクト中...</p>
  </body>
</html>