---
import ToolFaq from '../../../../components/tools/ToolFaq.astro';
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ImageCompressor from '../../../../components/tools/ImageCompressor.astro';

const faqs = [
  { q: '画像はサーバーに送信されますか?', a: 'いいえ。すべての処理はお使いのブラウザ内で行われ、画像が外部へ送信されることはありません。' },
  { q: 'Smart Optimize では何をしていますか?', a: '画像の種類(写真かイラストか)と透過の有無を判定し、JPEG と WebP のうち小さく仕上がる形式と品質を自動で選びます。圧縮には MozJPEG などの高性能なエンコーダを使うため、ブラウザ標準より小さく仕上がります。' },
  { q: '目標サイズを指定したのに届かないことがあります', a: '画像の内容によっては、画質を下げても指定サイズに収まらない場合があります。その場合は自動で少し縮小して再試行し、それでも届かない時はお知らせします。' },
  { q: 'スマートフォンの大きな写真でも使えますか?', a: '使えます。極端に大きい画像は安全に処理できるサイズまで自動で縮小します。長辺の最大サイズを詳細設定で指定すると、さらに軽くなります。' },
  { q: 'PNG のまま小さくできますか?', a: 'PNG のまま小さくするのではなく、JPEG / WebP / AVIF への変換で軽くします。透過PNG は WebP か AVIF で透過を保ったまま軽量化できます。形式を変えたくない場合は「画像変換」のPNG出力(可逆の再圧縮)をお使いください。' },
  { q: '複数の画像をまとめて圧縮できますか?', a: 'はい。一度に最大30枚まで選べます。1枚ずつの結果を確認でき、ZIPにまとめて保存することもできます。' },
  { q: 'AVIF を選ぶとどうなりますか?', a: '最も小さく仕上がりますが、処理に時間がかかります。AVIF に対応していない古いアプリや環境では開けないことがあります。' },
];
---
<ToolLayout
  current="compressor"
  title="画像圧縮ツール【無料・ブラウザ内で処理】"
  heading="画像圧縮ツール"
  description="画像をブラウザ内だけで圧縮できる無料ツール。アップロード不要。100KB・200KB・500KBなど目標サイズの指定にも対応し、Before/Afterで画質を確認できます。"
  lead="画像を選んで「Smart Optimize」を押すだけ。画質とサイズのバランスを自動で調整します。複数枚の一括処理にも対応。"
>
  <ImageCompressor />
  <ToolFaq faqs={faqs} />
</ToolLayout>
