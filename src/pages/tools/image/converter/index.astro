---
import ToolFaq from '../../../../components/tools/ToolFaq.astro';
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ImageConverter from '../../../../components/tools/ImageConverter.astro';

const faqs = [
  { q: '画像はサーバーに送信されますか?', a: 'いいえ。すべての処理はお使いのブラウザ内で行われ、画像が外部へ送信されることはありません。' },
  { q: 'JPEG・PNG・WebP・AVIF はどれを選べばよいですか?', a: '写真を軽くしたいならJPEGかWebP、さらに小さくしたいならAVIF、透明な部分や文字・イラストをくっきり残したいならPNGが向いています。WebPとAVIFは軽くて透過にも対応していますが、古いアプリでは開けないことがあります。AVIFは処理に時間がかかります。' },
  { q: '透明な背景のPNGをJPEGにするとどうなりますか?', a: 'JPEGは透明に対応していないため、透明な部分は白(詳細設定で黒にも変更可能)になります。透明を残したい場合は、PNGかWebPを選んでください。' },
  { q: '変換すると画質は落ちますか?', a: 'PNGへの変換は劣化しません。JPEG・WebP・AVIFは圧縮のため、わずかに画質が変わります。初期設定の「高画質」では、見た目の差はほとんどありません。' },
  { q: 'AVIFには変換できますか?', a: 'はい。AVIFの読み込みも、AVIFへの書き出しもできます。ブラウザの機能に頼らず専用のエンコーダで変換するため、多くのブラウザで使えます。ただし画像によっては数秒かかります。' },
  { q: 'サイズも変えたいのですが?', a: 'このツールでは画像の大きさ(縦横のピクセル数)は変わりません。大きさを変えたい場合は「画像リサイズ」、ファイルサイズを小さくしたい場合は「画像圧縮」をお使いください。' },
];
---
<ToolLayout
  current="converter"
  title="画像変換ツール(JPEG・PNG・WebP・AVIF)【無料・ブラウザ内で処理】"
  heading="画像変換ツール"
  description="JPEG・PNG・WebP・AVIFを相互に変換できる無料ツール。ブラウザ内だけで処理するのでアップロード不要。透過画像の背景色も選べ、Before/Afterで結果を確認できます。"
  lead="画像を選んで、変換したい形式を選ぶだけ。サイズや見た目はそのままで形式だけ変わります。"
>
  <ImageConverter />
  <ToolFaq faqs={faqs} />
</ToolLayout>
