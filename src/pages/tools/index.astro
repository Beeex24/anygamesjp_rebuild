---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { TOOLS, TOOL_CATEGORIES, TOOL_COLORS, TOOL_GOALS } from '../../lib/tools';

const groups = (Object.keys(TOOL_CATEGORIES) as (keyof typeof TOOL_CATEGORIES)[])
  .map((key) => ({ key, label: TOOL_CATEGORIES[key], items: TOOLS.filter((t) => t.category === key) }))
  .filter((g) => g.items.length > 0);
const goals = TOOL_GOALS.map((g) => ({ ...g, tool: TOOLS.find((t) => t.slug === g.slug)! })).filter((g) => g.tool);
const crumbs = [{ name: 'ホーム', href: '/' }, { name: 'Tools' }];
---
<BaseLayout
  title="Tools(無料Webツール一覧)"
  image="/og/tools.png"
  description="ANYGAMESの無料Webツール一覧。画像圧縮など、ブラウザだけで使える便利ツールを順次追加しています。"
  breadcrumbs={[{ name: 'ホーム', href: '/' }, { name: 'Tools', href: '/tools/' }]}
>
  <div class="container">
    <Breadcrumb items={crumbs} />
    <h1 class="heading-c">Tools</h1>
    <p class="lead">ブラウザだけで使える無料ツール。データは外部に送信されません。</p>

    <section class="section goals" aria-labelledby="goals-h">
      <h2 id="goals-h" class="section-title">やりたいことから探す</h2>
      <ul class="goal-list">
        {goals.map((g) => (
          <li>
            <a href={g.tool.href} style={`--c:${TOOL_COLORS[g.tool.category]}`}>
              <strong>{g.label}</strong>
              <span>{g.hint} ›</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <ul class="legend" aria-label="カテゴリの色">
      {groups.map((g) => <li style={`--c:${TOOL_COLORS[g.key]}`}>{g.label}</li>)}
    </ul>

    {groups.map((g) => (
      <section class="section group" style={`--c:${TOOL_COLORS[g.key]}`}>
        <h2 class="group-title">{g.label}<small>{g.items.length}</small></h2>
        <ul class="list">
          {g.items.map((t) => (
            <li><a href={t.href}><strong>{t.name}</strong><span>{t.summary}</span><em>開く ›</em></a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
<style>
  .lead { margin: 0; text-align: center; color: var(--text-sub); }
  .goals { padding-bottom: 8px; }
  .goal-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .goal-list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .goal-list { grid-template-columns: repeat(4, 1fr); } }
  .goal-list a { display: grid; gap: 2px; align-content: center; min-height: 72px; height: 100%; padding: 12px 16px; border-radius: var(--radius); background: var(--c); color: #fff; text-decoration: none; transition: transform .2s, filter .2s; }
  .goal-list a:hover { transform: translateY(-3px); filter: brightness(1.07); }
  .goal-list strong { font-size: .98rem; line-height: 1.4; }
  .goal-list span { font-size: .78rem; opacity: .9; }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 16px; justify-content: center; margin: 8px 0 0; padding: 0; font-size: .8rem; color: var(--text-sub); }
  .legend li::before { content: ''; display: inline-block; width: .8em; height: .8em; margin-right: .4em; border-radius: 50%; background: var(--c); vertical-align: -.05em; }
  .group-title { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; padding: 8px 14px; border-left: 6px solid var(--c); background: color-mix(in srgb, var(--c) 10%, white); border-radius: 0 var(--radius) var(--radius) 0; font-size: 1.15rem; }
  .group-title small { background: var(--c); color: #fff; border-radius: 999px; padding: 0 9px; font-size: .75rem; line-height: 1.7; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 640px) { .list { grid-template-columns: repeat(2, 1fr); } }
  .list a { display: grid; gap: 4px; height: 100%; padding: 16px 16px 14px; border: 1px solid var(--line); border-top: 4px solid var(--c); border-radius: var(--radius); color: inherit; text-decoration: none; min-height: 48px; background: var(--bg); transition: transform .2s, box-shadow .2s; }
  .list a:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .list strong { color: var(--c); font-size: 1.05rem; }
  .list span { font-size: .875rem; color: var(--text-sub); }
  .list em { font-style: normal; justify-self: end; font-size: .8rem; font-weight: 700; color: var(--c); }
</style>
