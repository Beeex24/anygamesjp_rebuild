---
import ToolFaq from '../../../../components/tools/ToolFaq.astro';
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import PsuCalculator from '../../../../components/tools/PsuCalculator.astro';

const faqs = [
  { q: '電源容量はどうやって計算していますか?', a: 'CPU・グラボ・そのほかのパーツの消費電力を合計し、「最大消費時に電源容量の何%まで使うか」で割って必要な容量を求め、市販されている容量に切り上げています。' },
  { q: 'なぜ、合計消費電力ぴったりの電源ではいけないのですか?', a: '最大時の消費電力ぎりぎりで使うと、電源に余裕がなく、不安定になったり、電源の寿命が短くなる原因になります。一般に、電源は容量の半分前後で使うと効率がよいとされるため、余裕を見て選ぶのがおすすめです。' },
  { q: 'CPUとグラボは、どの数値を入力すればよいですか?', a: 'CPUは、メーカーの仕様にある「最大ターボ・パワー」など最大時の消費電力を、グラボは「TGP」や「TBP」の値を入力してください。グラボを使わない構成は、0を入力します。' },
  { q: 'グラボのメーカーが推奨する電源容量と違う場合は?', a: 'グラフィックボードのメーカーは、推奨する電源容量を公表していることが多いです。このツールの結果と、メーカーの推奨容量を比べて、大きい方を選んでください。' },
  { q: 'そのほかのパーツの消費電力は、正確ですか?', a: 'マザーボードやメモリなどの値は、一般的な概算の目安です。お使いのパーツの仕様がわかる場合は、「そのほかのパーツ」の数値を書き換えてください。' },
];
---
<ToolLayout
  current="psu"
  title="PC電源容量計算ツール(必要なワット数の目安)【無料】"
  heading="PC電源容量計算ツール"
  description="CPUとグラフィックボードなどの消費電力から、自作PCに必要な電源ユニットの容量(W)を計算できる無料ツール。余裕度も選べ、市販の容量に切り上げて表示します。"
  lead="パーツの消費電力から、必要な電源容量の目安を計算します。"
>
  <PsuCalculator />
  <ToolFaq faqs={faqs} />
</ToolLayout>
