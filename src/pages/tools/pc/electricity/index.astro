---
import ToolFaq from '../../../../components/tools/ToolFaq.astro';
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import ElectricityCalculator from '../../../../components/tools/ElectricityCalculator.astro';

const faqs = [
  { q: '電気代はどうやって計算していますか?', a: '消費電力(kW)× 使用時間(h)× 電力量料金の単価(円/kWh)で計算しています。たとえば300Wで1日4時間、30日使うと36kWhで、単価31円なら1,116円です。' },
  { q: '消費電力は、どこで調べればよいですか?', a: 'パーツの仕様や電源の定格容量は、最大値を示しているため、実際の消費電力より大きくなります。正確に知りたい場合は、ワットチェッカーなどで実際に測定するのがおすすめです。' },
  { q: '初期値の単価31円は、何の値ですか?', a: '全国家庭電気製品公正取引協議会(公取協)が示す、電力料金の目安単価(税込)です。2022年7月に改定されたものです。契約している電力会社やプランで変わるため、わかる場合は置き換えてください。' },
  { q: 'ゲームをしているときとしていないときで、消費電力が違う場合は?', a: '「ほかの使い方も合算する」に、通常時の消費電力と使用時間を入力すると、2つの使い方を合算して計算できます。' },
  { q: '基本料金や再エネ賦課金は含まれますか?', a: '基本料金は含まれません。燃料費調整額や再エネ賦課金は、入力した単価に含まれているかで変わります。契約中の単価がわからない場合は、検針票や会員ページでご確認ください。' },
];
---
<ToolLayout
  current="electricity"
  title="PCの電気代計算ツール(消費電力×使用時間)【無料】"
  heading="PCの電気代計算ツール"
  description="消費電力(W)と使用時間から、パソコンの電気代を1日・1か月・1年で計算できる無料ツール。ゲーム中と通常時を合算でき、電力量料金の単価も自由に変更できます。"
  lead="消費電力と使用時間を入れるだけで、電気代の目安がわかります。"
>
  <ElectricityCalculator />
  <ToolFaq faqs={faqs} />
</ToolLayout>
