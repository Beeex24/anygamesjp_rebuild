---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AffiliateGrid from '../components/AffiliateGrid.astro';
import AdSlot from '../components/AdSlot.astro';
import AdSenseScript from '../components/AdSenseScript.astro';
import { getCollection } from 'astro:content';
import { getAllPosts, SECTIONS, type Post, type SectionKey } from '../lib/site';
import { TOOLS } from '../lib/tools';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const all = await getAllPosts();
const latest = all.slice(0, 6);

// カテゴリ別セクション(各3件)。表示順はここで決める。
const categoryOrder: SectionKey[] = ['blog', 'mobileblog', 'device', 'minecraft_blog', 'minecraft_mod_blog'];
const categories = await Promise.all(
  categoryOrder.map(async (key) => {
    const section = SECTIONS.find((s) => s.key === key)!;
    const posts = (await getCollection(key)) as Post[];
    posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return { ...section, posts: posts.slice(0, 3) };
  }),
);

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: 'https://anygamesjp.com/',
  description: SITE_DESCRIPTION,
};
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <AdSenseScript slot="head" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(websiteLd)} />

  <section class="hero">
    <div class="container">
      <p class="eyebrow">ANYGAMES</p>
      <h1>ゲーム・PC・ガジェットを、<br />もっと便利に。</h1>
      <p class="lead">ゲームやガジェットの最新情報と、ブラウザだけで使える無料ツールをお届けします。</p>
      <p class="cta">
        <a class="btn" href="/tools/">無料ツールを使う</a>
        <a class="btn btn-sub" href="#latest">最新記事を見る</a>
      </p>
    </div>
  </section>

  <div class="container">
    <section class="section" aria-labelledby="tools">
      <SectionHeading title="注目のツール" href="/tools/" linkLabel="ツール一覧" />
      <ul class="tools">
        {TOOLS.map((t) => (
          <li><a href={t.href}><strong>{t.name}</strong><span>{t.summary}</span></a></li>
        ))}
      </ul>
    </section>

    <section class="section" id="latest" aria-labelledby="latest-h">
      <SectionHeading title="最新記事" href="/all/" linkLabel="すべての記事" />
      <ArticleList posts={latest} />
    </section>

    <AdSlot slot="listFeed" />

    {categories.map((c) => (
      <section class="section" aria-label={c.label}>
        <SectionHeading title={c.label} href={c.path} />
        <ArticleList posts={c.posts} />
      </section>
    ))}

    <section class="section" aria-labelledby="devices">
      <SectionHeading title="おすすめのデバイス" />
      <AffiliateGrid />
    </section>
  </div>
</BaseLayout>
<style>
  .hero { background: var(--bg-soft); border-bottom: 1px solid var(--line); padding: 40px 0 36px; }
  .eyebrow { margin: 0 0 8px; font-weight: 800; letter-spacing: .12em; color: var(--accent); font-size: .8125rem; }
  h1 { font-size: 1.5rem; margin: 0 0 12px; word-break: keep-all; text-wrap: balance; }
  .lead { margin: 0 0 20px; color: var(--text-sub); max-width: 36em; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; }
  .cta .btn { flex: 1 1 200px; }
  @media (min-width: 640px) { h1 { font-size: 2.25rem; } .cta .btn { flex: 0 0 auto; } }
  .tools { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 640px) { .tools { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .tools { grid-template-columns: repeat(3, 1fr); } }
  .tools a { display: grid; gap: 4px; padding: 16px; border: 1px solid var(--line); border-radius: var(--radius); color: inherit; text-decoration: none; min-height: 48px; }
  .tools a:hover { border-color: var(--accent); }
  .tools span { font-size: .875rem; color: var(--text-sub); }
</style>
