---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import RankingWidget from "../components/RankingWidget.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const mobilePosts = (await getCollection("mobileblog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const devicePosts = (await getCollection("device")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allPosts = [...posts, ...mobilePosts, ...devicePosts].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// ページネーション設定
const POSTS_PER_PAGE = 9; // 1ページあたりの記事数
---

<!doctype html>
<html lang="ja">

    <BaseHead 
      title={SITE_TITLE} 
      description={SITE_DESCRIPTION} 
      image="/placeholder-image.jpg"
    />

  <head>
    <!-- Swiper.js のスタイルとスクリプト -->

    <link
    rel="stylesheet"
    href="https://unpkg.com/swiper/swiper-bundle.min.css"
    />
    <script src="https://unpkg.com/swiper/swiper-bundle.min.js" defer></script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const swiperContainer = document.querySelector('.swiper-container');
      if (swiperContainer instanceof HTMLElement) {
        // 初期高さを設定（カードの想定高さ）
        swiperContainer.style.minHeight = '320px';
      }
        // Swiperライブラリが読み込まれるまで待機
        function initSwiper() {
          // TypeScript型エラー回避のためanyとして扱う
          const SwiperClass = (window as any).Swiper;
          if (typeof SwiperClass !== 'undefined') {
            new SwiperClass(".swiper-container", {
              loop: true, // ループを有効化
              autoplay: {
                delay: 4000, // スライド間隔
                disableOnInteraction: false, // ユーザー操作後も自動再生を継続
              },
              speed: 800, // アニメーション速度
              navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
              },
              pagination: {
                el: ".swiper-pagination",
                clickable: true,
              },
              slidesPerView: 1, // デフォルトで1スライドを表示
              spaceBetween: 20, // スライド間の余白
              breakpoints: {
                768: {
                  slidesPerView: 2, // 中画面では2スライドを表示
                  spaceBetween: 20, // スライド間の余白
                },
                1024: {
                  slidesPerView: 5, // 大画面では3スライドを表示
                  spaceBetween: 30, // スライド間の余白
                },
              },
            on: {
              init: function() {
                // 初期化完了後に高さ制限を解除
                setTimeout(() => {
                  if (swiperContainer instanceof HTMLElement) {
                    swiperContainer.style.minHeight = 'auto';
                  }
                }, 100);
              }
            }
          });
        } else {
          setTimeout(initSwiper, 50); // 待機時間を短縮
        }
      }
      
      initSwiper();
    });
  </script>

    <style>
      /* スライダーセクションのスタイル */
      .blog-slider-section {
        padding: 1rem;
        background-color: #ffffff;
        border-radius: 8px;
        margin: 0.5rem auto;
        max-width: calc(100vw - 1rem);
        width: calc(100vw - 1rem);
        position: relative;
        box-sizing: border-box;
        min-height: 400px;
      }

      .blog-slider-section h2 {
        font-size: 1.8rem;
        text-align: center;
        margin-bottom: 1rem;
        color: #333;
      }

      .swiper-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        overflow: hidden; /* 画面外に出る部分を隠す */
        height: 320px;
        background: linear-gradient(90deg, #8f8f8f 80%, #e0e0e0 50%, #8f8f8f 80%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
        border-radius: 12px;
      }

      .swiper-container.swiper-initialized {
        animation: none;
        background: none;
        height: auto; /* 初期化後は自動高さに */
      }

      @keyframes loading {
      0% {
      background-position: 200% 0;
        }
      100% {
      background-position: -200% 0;
        }
      }

      .swiper,
      .swiper-wrapper {
        position: relative;
        z-index: 1;
      }

      .swiper-wrapper {
        box-sizing: content-box;
        display: flex;
        height: 100%;
        width: 100%;
      }

      .swiper-slide {
        display: flex;
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
        flex-shrink: 0;
        height: 100%;
        width: auto;
      }

      .blog-card {
        width: 100%;
        max-width: 350px;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        text-decoration: none;
        color: inherit;
        margin: 0 auto;
        transition:
          box-shadow 0.3s,
          transform 0.3s;
        height: 350px;
        display: flex;
        flex-direction: column;
      }

      .blog-card:hover {
        transform: translateY(-10px) scale(1.03);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
      }

      .blog-card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        flex-shrink: 0;
      }

      .blog-card-content {
        padding: 0.5rem;
      }

      .blog-card-title {
        font-size: 1.1rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
        color: #222;
      }

      .blog-card-date {
        font-size: 0.8rem;
        color: #888;
        text-align: right;
      }

      /* Swiperナビゲーションボタンのカスタマイズ */
      .swiper-button-next,
      .swiper-button-prev {
        background: rgba(0, 0, 0, 0.6);
        color: #fff;
        cursor: pointer;
        height: 48px;
        width: 48px;
        border-radius: 50%;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: background 0.2s;
      }
      .swiper-button-next {
        right: 20px;
        left: auto;
      }
      .swiper-button-prev {
        left: 20px;
        right: auto;
      }
      .swiper-button-next:after,
      .swiper-button-prev:after {
        font-size: 1.6rem;
        font-weight: bold;
      }
      .swiper-button-next:hover,
      .swiper-button-prev:hover {
        background: rgba(0, 0, 0, 0.85);
      }

      /* Swiperページネーション */
      .swiper-pagination {
        position: absolute;
        bottom: 10px;
        left: 0;
        width: 100%;
        text-align: center;
        z-index: 10;
      }
      .swiper-pagination-bullet {
        background: #000;
        opacity: 0.3;
        width: 10px;
        height: 10px;
        margin: 0 4px;
        border-radius: 50%;
        display: inline-block;
        transition: opacity 0.2s;
      }
      .swiper-pagination-bullet-active {
        background: #4781ff;
        opacity: 1;
      }

      /* ページネーションスタイル */
      .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        padding: 1rem 0;
      }

      .pagination button,
      .pagination a {
        padding: 0.5rem 1rem;
        background: #fff;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        color: #333;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        font-size: 0.9rem;
      }

      .pagination button:hover:not(:disabled),
      .pagination a:hover {
        background: #4781ff;
        color: white;
        border-color: #4781ff;
        transform: translateY(-2px);
        box-shadow: 0 2px 8px rgba(71, 129, 255, 0.3);
      }

      .pagination button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .pagination .page-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0;
        font-size: 0.95rem;
      }

      .pagination .page-number.active {
        background: #4781ff;
        color: white;
        border-color: #4781ff;
      }

      .pagination .ellipsis {
        padding: 0.5rem;
        color: #666;
      }

      .view-all-link {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.8rem 1.5rem;
        background: linear-gradient(135deg, #4781ff, #3366ff);
        color: white;
        text-decoration: none;
        border-radius: 25px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(71, 129, 255, 0.3);
      }

      .view-all-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(71, 129, 255, 0.4);
        background: linear-gradient(135deg, #3366ff, #4781ff);
      }

      @media (max-width: 1024px) {
        .blog-slider-section {
          max-width: 100vw;
          width: 100vw;
        }
        .swiper-container {
          max-width: 98vw;
        }
      }
      @media (max-width: 768px) {
        .blog-slider-section {
          padding: 1rem 0.5rem;
          margin: 0;
          max-width: 100vw;
          width: 100vw;
        }
        .swiper-container {
          max-width: 100vw;
        }
        .blog-card {
          max-width: 95vw;
          margin: 0 2px;
          max-height: 480px;
        }

        .blog-card-title {
          font-size: 1.2rem; 
        }

        .blog-card-description {
          font-size: 0.92rem; /* 説明のフォントサイズをさらに小さく */
        }

        .swiper-button-next,
        .swiper-button-prev {
          width: 32px;
          height: 32px;
        }
        .swiper-button-next {
          right: 4px;
        }
        .swiper-button-prev {
          left: 4px;
        }

        .pagination {
          gap: 0.3rem;
        }

        .pagination button,
        .pagination a {
          padding: 0.4rem 0.8rem;
          font-size: 0.85rem;
        }

        .pagination .page-number {
          min-width: 35px;
          height: 35px;
        }
      }
    </style>
  </head>

  <style>
    @media (max-width: 768px) {
      /* ブログカードの画像サイズ調整 */
      .blog-card img {
        height: 100px; /* 高さをさらに縮小 */
        margin: 0 auto; /* 中央揃え */
      }

      /* ブログカードのタイトルと説明のフォントサイズ調整 */
      .blog-card-title {
        font-size: 0.9rem; /* タイトルのフォントサイズをさらに小さく */
      }

      .blog-card-description {
        font-size: 0.75rem; /* 説明のフォントサイズをさらに小さく */
      }

      /* ブログセクションのグリッド調整 */
      .blog-grid {
        grid-template-columns: 1fr; /* モバイル画面では1列表示 */
        gap: 0.5rem; /* カード間の余白を調整 */
      }

      /* スライダーのボタンサイズ調整 */
      .blog-slider-section .swiper-button-next,
      .blog-slider-section .swiper-button-prev {
        width: 25px; /* ボタンの幅をさらに縮小 */
        height: 25px; /* ボタンの高さをさらに縮小 */
      }

      /* アフィリエイトセクションのグリッド調整 */
      .affiliate-grid {
        grid-template-columns: 1fr; /* モバイル画面では1列表示 */
        gap: 1rem; /* カード間の余白を調整 */
      }

      /* 通知バーのフォントサイズ調整 */
      .notification-bar {
        font-size: 1rem; /* フォントサイズをさらに小さく */
      }

      /* メインタイトルのフォントサイズ調整 */
      main h1 {
        font-size: 1.2rem; /* タイトルのフォントサイズをさらに小さく */
      }

      main p {
        font-size: 0.9rem; /* 説明文のフォントサイズをさらに小さく */
      }

      /* 広告セクションの非表示 */
      .side-ads {
        display: none; /* モバイル画面では非表示 */
      }

      .ad-top-right {
        display: none; /* モバイル画面では非表示 */
      }
    
      {
        box-sizing: border-box;
      }
      html, body {
        overflow-x: hidden !important;
        width: 100% !important;
        max-width: 100vw !important;
      }
    }
  </style>

  <!-- 上部右側ディスプレイ広告 -->
   <head>
   <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4929223237591717"
     crossorigin="anonymous"></script>
  </head>

  <body>
    <Header />
    <main>
      <!-- javascriptのスワイパーコンテンツ表示 -->

      <section class="blog-slider-section">
        <h2>最 新 記 事</h2>
        <div class="swiper-container">
          <div class="swiper-wrapper">
            {
              allPosts.slice(0, 10).map((post) => (
                <div class="swiper-slide">
                  <a href={`/${post.collection}/${post.id}/`} class="blog-card">
                    <img src={post.data.heroImage} alt={post.data.title} />
                    <div class="blog-card-content">
                      <div class="blog-card-title">{post.data.title}</div>
                      <div class="blog-card-date"><FormattedDate date={post.data.pubDate} /></div>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>
          <!-- スライダーのナビゲーションボタン -->
          <div class="swiper-button-next"></div>
          <div class="swiper-button-prev"></div>
          <!-- スライダーのページネーション -->
          <div class="swiper-pagination"></div>
        </div>
      </section>

      <!-- ページ中央　タブリスト表示 -->

      <html lang="ja">
        <head>
          <meta charset="UTF-8" />
          <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
          />
          <title>タブ付き記事リスト</title>
          <style>
            * {
              margin: 0;
              padding: 0;
              box-sizing: border-box;
            }

            body {
              font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
              background: linear-gradient(135deg, #e2e2e2 100%);
              min-height: 100vh;
              padding: 2rem;
            }

            .container {
              max-width: 1200px;
              margin: 0 auto;
              background: rgba(255, 255, 255, 0.95);
              border-radius: 20px;
              overflow: hidden;
              box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
              backdrop-filter: blur(10px);
            }

            .tab-header {
              display: flex;
              background: linear-gradient(135deg, #2c3e50, #3498db);
              position: relative;
              overflow: hidden;
            }

            .tab-header::before {
              content: "";
              position: absolute;
              top: 0;
              left: 0;
              right: 0;
              bottom: 0;
              background: linear-gradient(
                45deg,
                transparent 30%,
                rgba(255, 255, 255, 0.1) 50%,
                transparent 70%
              );
              animation: shimmer 3s infinite;
            }

            @keyframes shimmer {
              0% {
                transform: translateX(-100%);
              }
              100% {
                transform: translateX(200%);
              }
            }

            .tab-button {
              flex: 1;
              padding: 1.5rem 2rem;
              background: none;
              border: none;
              color: rgba(255, 255, 255, 0.7);
              font-size: 1.1rem;
              font-weight: 600;
              cursor: pointer;
              transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
              position: relative;
              z-index: 2;
              text-transform: uppercase;
              letter-spacing: 1px;
            }

            .tab-button:hover {
              color: rgba(255, 255, 255, 0.9);
              transform: translateY(-2px);
            }

            .tab-button.active {
              color: #fff;
              background: rgba(255, 255, 255, 0.2);
              backdrop-filter: blur(10px);
            }

            .tab-button.active::after {
              content: "";
              position: absolute;
              bottom: 0;
              left: 50%;
              width: 50px;
              height: 3px;
              background: linear-gradient(90deg, #ff6b6b, #4ecdc4);
              transform: translateX(-50%);
              border-radius: 2px;
            }

            .tab-content {
              padding: 2rem;
              min-height: 600px;
            }

            .article-grid {
              display: grid;
              grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
              gap: 2rem;
              opacity: 0;
              transform: translateY(20px);
              animation: fadeInUp 0.6s ease forwards;
            }

            @keyframes fadeInUp {
              to {
                opacity: 1;
                transform: translateY(0);
              }
            }

            .article-card {
              background: #fff;
              border-radius: 16px;
              overflow: hidden;
              box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
              transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
              position: relative;
              cursor: pointer;
            }

            .article-card::before {
              content: "";
              position: absolute;
              top: 0;
              left: 0;
              right: 0;
              bottom: 0;
              background: linear-gradient(
                135deg,
                rgba(255, 107, 107, 0.1),
                rgba(78, 205, 196, 0.1)
              );
              opacity: 0;
              transition: opacity 0.3s ease;
            }

            .article-card:hover {
              transform: translateY(-10px) scale(1.02);
              box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
            }

            .article-card:hover::before {
              opacity: 1;
            }

            .article-image {
              width: 100%;
              height: 200px;
              object-fit: cover;
              transition: transform 0.6s ease;
            }

            .article-card:hover .article-image {
              transform: scale(1.1);
            }

            .article-content {
              padding: 1.5rem;
              position: relative;
              z-index: 2;
            }

            .article-category {
              display: inline-block;
              padding: 0.3rem 0.8rem;
              background: linear-gradient(135deg, #ff6b6b, #ee5a24);
              color: white;
              font-size: 0.8rem;
              font-weight: 600;
              border-radius: 20px;
              margin-bottom: 1rem;
              text-transform: uppercase;
              letter-spacing: 0.5px;
            }

            .article-title {
              font-size: 1.3rem;
              font-weight: 700;
              color: #2c3e50;
              margin-bottom: 0.8rem;
              line-height: 1.4;
              transition: color 0.3s ease;
            }

            .article-card:hover .article-title {
              color: #3498db;
            }

            .article-description {
              color: #7f8c8d;
              font-size: 0.95rem;
              line-height: 1.6;
              margin-bottom: 1rem;
            }

            .article-meta {
              display: flex;
              justify-content: space-between;
              align-items: center;
              color: #95a5a6;
              font-size: 0.85rem;
            }

            .article-date {
              font-weight: 600;
            }

            .article-card-link {
              text-decoration: none;
              color: inherit;
              display: block;
              transition: transform 0.3s ease;
            }

            .article-card-link:hover {
              transform: translateY(-10px);
            }

            .read-more {
              background: linear-gradient(135deg, #3498db, #2980b9);
              color: white;
              padding: 0.5rem 1rem;
              border-radius: 20px;
              text-decoration: none;
              font-size: 0.8rem;
              font-weight: 600;
              transition: all 0.3s ease;
              text-transform: uppercase;
              letter-spacing: 0.5px;
            }

            .read-more:hover {
              background: linear-gradient(135deg, #2980b9, #3498db);
              transform: translateY(-2px);
              box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
            }

            .tab-panel {
              display: none;
              animation: slideIn 0.5s ease forwards;
            }

            .tab-panel.active {
              display: block;
            }

            @keyframes slideIn {
              from {
                opacity: 0;
                transform: translateX(20px);
              }
              to {
                opacity: 1;
                transform: translateX(0);
              }
            }

            .empty-state {
              text-align: center;
              padding: 4rem 2rem;
              color: #7f8c8d;
            }

            .empty-state h3 {
              font-size: 1.5rem;
              margin-bottom: 1rem;
              color: #95a5a6;
            }

            .tab-section {
              margin-bottom: 2rem;
              text-align: center;
            }

            .tab-section h1 {
              color: white;
              margin-bottom: 1rem;
              font-size: 2rem;
            }

            .tab-list {
              display: flex;
              justify-content: center;
              gap: 1rem;
              list-style: none;
              margin-bottom: 2rem;
            }

            .tab-item {
              padding: 0.5rem 1rem;
              background: rgba(255, 255, 255, 0.2);
              color: white;
              border-radius: 10px;
              cursor: pointer;
              transition: all 0.3s ease;
            }

            .tab-item.active {
              background: rgba(255, 255, 255, 0.3);
            }

            @media (max-width: 768px) {
              .container {
                margin: 1rem;
                border-radius: 15px;
              }

              .tab-button {
                padding: 1rem;
                font-size: 0.9rem;
              }

              .tab-content {
                padding: 1rem;
              }

              .article-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
              }

              .article-card {
                border-radius: 12px;
              }

              .article-image {
                height: 160px;
              }

              .article-content {
                padding: 1rem;
              }

              .article-title {
                font-size: 1.1rem;
              }

              .tab-list {
                flex-direction: column;
                align-items: center;
              }
              .tab-section {
                display: none;
              }
            }

           /* アドセンス広告（モバイル）の高さを指定*/
            @media screen and (max-width: 768px) {
              .wpaw-google-adsense {
                min-height: 320px;
              }
            }
          </style>
        </head>

  <body>

    <div style="display:flex; gap:16px; flex-wrap:wrap; justify-content: center;">
  <RankingWidget
    title="ゲーム・映画全般（人気TOP10）"
