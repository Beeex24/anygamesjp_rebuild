---
import PostListPage from '../../../components/PostListPage.astro';
import { getCollection } from 'astro:content';
import { pageRoutes, type ListPageProps } from '../../../lib/list';

// 既存URL: /mobileblog/page/N/ （9件/ページ）
export async function getStaticPaths() {
  return pageRoutes(await getCollection('mobileblog'), 9);
}
const p = Astro.props as ListPageProps;
const href = (n: number) => `/mobileblog/page/${n}/`;
---
<PostListPage {...p} heading="モバイル・ゲーム機" lead="スマホゲームや携帯ゲーム機に関する記事の一覧です。" basePath="/mobileblog/" pageHref={href} gameFilter={false}
  breadcrumb={[{ name: 'ホーム', href: '/' }, { name: 'モバイル・ゲーム機', href: '/mobileblog/' }, { name: 'ページ一覧' }]} />
