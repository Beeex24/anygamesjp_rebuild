---
import PostListPage from '../../components/PostListPage.astro';
import { getCollection } from 'astro:content';
import { restRoutes, type ListPageProps } from '../../lib/list';

// 既存URL: /mobileblog/ と /mobileblog/2/ …（100件/ページ）
export async function getStaticPaths() {
  return restRoutes(await getCollection('mobileblog'), 100);
}
const p = Astro.props as ListPageProps;
const href = (n: number) => (n === 1 ? '/mobileblog/' : `/mobileblog/${n}/`);
---
<PostListPage {...p} heading="モバイル・ゲーム機" lead="スマホゲームや携帯ゲーム機に関する記事の一覧です。" basePath="/mobileblog/" pageHref={href} gameFilter={false}
  breadcrumb={[{ name: 'ホーム', href: '/' }, { name: 'モバイル・ゲーム機' }]} />
