---
// src/layouts/MinecraftModLayout.astro
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection } from "astro:content";

interface Props {
  post: CollectionEntry<"minecraft_mod_blog">;
  Content: any;
}

const { post, Content } = Astro.props;

// OGP用の画像URL（絶対URLに変換）
const siteUrl =
  Astro.site?.toString() || `${Astro.url.protocol}//${Astro.url.host}`;
const heroImage = post.data.heroImage;
const ogImage = heroImage
  ? heroImage.startsWith("http")
    ? heroImage
    : `${siteUrl}${heroImage.startsWith("/") ? "" : "/"}${heroImage}`
  : `${siteUrl}/placeholder-image.jpg`;

// 現在のページURL
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin)
  .href;

// 関連記事を取得（同じカテゴリー）
const allPosts = await getCollection("minecraft_mod_blog");
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// おすすめの記事（最新8件）
const recommendedPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title={post.data.title}
      description={post.data.description}
      image={heroImage}
      ogType="article"
      siteName="ANYGAMES放送局"
      pubDate={post.data.pubDate}
      updatedDate={post.data.updatedDate}
      section="Minecraft MOD"
      tags={post.data.tags || ["Minecraft", "MOD"]}
    />

    <!-- OGP (Open Graph Protocol) メタタグ -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="ANYGAMES放送局" />
    <meta property="og:locale" content="ja_JP" />

    <!-- 記事固有のOGPタグ -->
    <meta
      property="article:published_time"
      content={post.data.pubDate.toISOString()}
    />
    {
      post.data.updatedDate && (
        <meta
          property="article:modified_time"
          content={post.data.updatedDate.toISOString()}
        />
      )
    }
    <meta property="article:section" content="Minecraft MOD" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.data.title} />
    <meta name="twitter:description" content={post.data.description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 追加のメタタグ -->
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- プリロード重要リソース -->
    {heroImage && <link rel="preload" as="image" href={heroImage} />}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Noto+Sans+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4929223237591717"
      crossorigin="anonymous"></script>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        overflow-x: hidden;
      }

      :root {
        --dirt-brown: #8b6f47;
        --stone-gray: #7f7f7f;
        --grass-green: #7cb342;
        --dark-stone: #3a3a3a;
        --wood-tan: #9c6d3e;
        --light-bg: #e8e1d5;
        --diamond-cyan: #4dd0e1;
        --redstone-red: #d32f2f;
        --emerald-green: #00c853;
        --shadow: rgba(0, 0, 0, 0.3);
      }

      body {
        font-family: "Noto Sans JP", sans-serif;
        background-color: var(--light-bg);
        background-image:
          repeating-linear-gradient(
            0deg,
            transparent,
            transparent 4px,
            rgba(0, 0, 0, 0.02) 4px,
            rgba(0, 0, 0, 0.02) 8px
          ),
          repeating-linear-gradient(
            90deg,
            transparent,
            transparent 4px,
            rgba(0, 0, 0, 0.02) 4px,
            rgba(0, 0, 0, 0.02) 8px
          );
        color: var(--dark-stone);
        line-height: 1.8;
        overflow-x: hidden;
      }

      /* Header AdSense */
      .header-ad {
        text-align: center;
        margin: 2rem auto;
        max-width: 1200px;
        padding: 0 2rem;
      }

      /* Header */
      header.mod-header {
        background: linear-gradient(
          180deg,
          var(--dirt-brown) 0%,
          var(--wood-tan) 100%
        );
        border-bottom: 6px solid var(--dark-stone);
        box-shadow: 0 8px 0 var(--shadow);
      }

      .header-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 2rem 1.5rem;
        width: 100%;
        box-sizing: border-box;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: white;
        text-decoration: none;
        font-weight: 700;
        margin-bottom: 1rem;
        transition: all 0.2s;
      }

      .back-link:hover {
        transform: translateX(-4px);
      }

      h1.page-title {
        font-family: "Press Start 2P", cursive;
        font-size: 1.5rem;
        color: #fff;
        text-shadow:
          4px 4px 0 var(--dark-stone),
          4px 4px 8px rgba(0, 0, 0, 0.5);
        margin-bottom: 0.5rem;
        letter-spacing: 1px;
        line-height: 1.5;
      }

      /* Hero Section */
      .hero-section {
        max-width: 1200px;
        margin: -30px auto 3rem;
        padding: 0 2rem;
        position: relative;
        z-index: 10;
        width: 100%;
        box-sizing: border-box;
      }

      .hero-card {
        background: white;
        border: 4px solid var(--dark-stone);
        box-shadow: 0 8px 0 var(--shadow);
        overflow: hidden;
        width: 100%;
        box-sizing: border-box;
      }

      .hero-image {
        width: 100%;
        height: 400px;
        background: linear-gradient(
          135deg,
          var(--grass-green) 0%,
          var(--emerald-green) 100%
        );
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 8rem;
        border-bottom: 4px solid var(--dark-stone);
      }

      .hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero-info {
        padding: 2rem;
        background: white;
      }

      .mod-meta-large {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
      }

      .mod-tag-large {
        padding: 0.6rem 1.2rem;
        font-size: 0.9rem;
        font-weight: 700;
        border-radius: 6px;
        border: 3px solid;
      }

      .mod-tag-large.version {
        background: #e3f2fd;
        border-color: #2196f3;
        color: #1976d2;
      }

      .mod-tag-large.category {
        background: #f3e5f5;
        border-color: #9c27b0;
        color: #7b1fa2;
      }

      .mod-tag-large.downloads {
        background: #e8f5e9;
        border-color: #4caf50;
        color: #388e3c;
      }

      .mod-tag-large.difficulty {
        background: #fff3e0;
        border-color: #ff9800;
        color: #f57c00;
      }

      .mod-tag-large.author {
        background: #fce4ec;
        border-color: #e91e63;
        color: #c2185b;
      }

      .mod-tag-large.modloader {
        background: #d3d3d3;
        border-color: #838383;
        color: #000000;
      }

      .mod-description-large {
        font-size: 1.1rem;
        color: #555;
        line-height: 1.8;
        margin-bottom: 1.5rem;
      }

      .mod-dates {
        display: flex;
        gap: 2rem;
        font-size: 0.9rem;
        color: #666;
        padding-top: 1rem;
        border-top: 2px solid #eee;
      }

      .mod-date-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .mod-date-label {
        font-weight: 700;
        color: var(--dark-stone);
      }

      /* Download Buttons */
      .download-section {
        max-width: 1200px;
        margin: 0 auto 3rem;
        padding: 0 2rem;
        width: 100%;
        box-sizing: border-box;
      }

      .download-buttons {
        background: white;
        border: 4px solid var(--dark-stone);
        box-shadow: 0 6px 0 var(--shadow);
        padding: 1.5rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
        width: 100%;
        box-sizing: border-box;
      }

      .download-btn {
        padding: 1rem 2rem;
        font-size: 1.1rem;
        font-weight: 700;
        border: 3px solid var(--dark-stone);
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
        font-family: "Noto Sans JP", sans-serif;
      }

      .download-btn.primary {
        background: var(--grass-green);
        color: white;
        box-shadow: 0 4px 0 #558b2f;
      }

      .download-btn.primary:hover {
        background: #8bc34a;
        transform: translateY(-2px);
        box-shadow: 0 6px 0 #558b2f;
      }

      .download-btn.secondary {
        background: var(--diamond-cyan);
        color: white;
        box-shadow: 0 4px 0 #0097a7;
      }

      .download-btn.secondary:hover {
        background: #4dd0e1;
        transform: translateY(-2px);
        box-shadow: 0 6px 0 #0097a7;
      }

      .download-btn:active {
        transform: translateY(2px);
        box-shadow: 0 2px 0 #558b2f;
      }

      /* NeoForge ボタン */
      .download-btn.neoforge {
        background: #d97706;
        color: white;
        box-shadow: 0 4px 0 #92400e;
      }
      .download-btn.neoforge:hover {
        background: #f59e0b;
        transform: translateY(-2px);
        box-shadow: 0 6px 0 #92400e;
      }

      /* Fabric ボタン */
      .download-btn.fabric {
        background: #6366f1;
        color: white;
        box-shadow: 0 4px 0 #3730a3;
      }
      .download-btn.fabric:hover {
        background: #818cf8;
        transform: translateY(-2px);
        box-shadow: 0 6px 0 #3730a3;
      }

      /* Quilt ボタン */
      .download-btn.quilt {
        background: #ec4899;
        color: white;
        box-shadow: 0 4px 0 #9d174d;
      }
      .download-btn.quilt:hover {
        background: #f472b6;
        transform: translateY(-2px);
        box-shadow: 0 6px 0 #9d174d;
      }

      /* Content Area */
      .content-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem 3rem;
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 2rem;
        width: 100%;
        box-sizing: border-box;
      }

      /* Main Content */
      .main-content {
        background: white;
        border: 4px solid var(--dark-stone);
        box-shadow: 0 6px 0 var(--shadow);
        padding: 2rem;
        min-height: 400px;
      }

      .main-content h2 {
        font-family: "Press Start 2P", cursive;
        font-size: 1.5rem;
        color: var(--dark-stone);
        margin-top: 2rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 4px solid var(--grass-green);
      }

      .main-content h2:first-child {
        margin-top: 0;
      }

      .main-content h3 {
        font-size: 1.3rem;
        color: var(--dark-stone);
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        font-weight: 700;
      }

      .main-content p {
        margin-bottom: 1rem;
        line-height: 1.8;
      }

      .main-content ul,
      .main-content ol {
        margin-left: 2rem;
        margin-bottom: 1rem;
      }

      .main-content li {
        margin-bottom: 0.5rem;
      }

      .main-content img {
        max-width: 100%;
        height: auto;
        border: 3px solid var(--dark-stone);
        margin: 1.5rem 0;
        box-shadow: 0 4px 0 var(--shadow);
      }

      .main-content code {
        background: var(--light-bg);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-family: "Courier New", monospace;
        border: 2px solid var(--stone-gray);
      }

      .main-content pre {
        background: var(--dark-stone);
        color: #fff;
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
        margin: 1.5rem 0;
        border: 3px solid var(--stone-gray);
      }

      .main-content pre code {
        background: none;
        border: none;
        padding: 0;
        color: #fff;
      }

      /* Content Ad */
      .content-ad {
        text-align: center;
        margin: 2rem auto;
        max-width: 100%;
      }

      /* おすすめの記事セクション */
      .recommended-posts {
        margin-top: 3rem;
        padding: 2rem;
        background: var(--light-bg);
        border: 4px solid var(--dark-stone);
        border-radius: 8px;
      }

      .recommended-posts h3 {
        font-family: "Press Start 2P", cursive;
        font-size: 1.2rem;
        color: var(--dark-stone);
        margin-bottom: 1.5rem;
        text-align: center;
      }

      .post-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.5rem;
      }

      .related-post-item {
        background: white;
        border: 3px solid var(--dark-stone);
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.3s;
        text-decoration: none;
        display: block;
      }

      .related-post-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 0 var(--shadow);
      }

      .post-image {
        width: 100%;
        height: 180px;
        overflow: hidden;
        background: var(--grass-green);
      }

      .post-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border: none;
        margin: 0;
        box-shadow: none;
      }

      .post-content {
        padding: 1rem;
      }

      .post-content h4 {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--dark-stone);
        margin-bottom: 0.5rem;
        line-height: 1.4;
      }

      .post-meta {
        font-size: 0.85rem;
        color: #666;
      }

      /* Tips セクション */
      .tips {
        margin-top: 2rem;
        padding: 1.5rem;
        background: #fff9e6;
        border: 3px solid #ffd700;
        border-radius: 8px;
      }

      .tips h4 {
        font-size: 1.1rem;
        margin-bottom: 1rem;
        color: var(--dark-stone);
      }

      .tips ul {
        list-style: none;
        margin-left: 0;
      }

      .tips li {
        margin-bottom: 1rem;
        line-height: 1.8;
      }

      .tips a {
        color: #2196f3;
        font-weight: 700;
        text-decoration: none;
      }

      .tips a:hover {
        text-decoration: underline;
      }

      /* Sidebar */
      .sidebar-section {
        background: white;
        border: 4px solid var(--dark-stone);
        box-shadow: 0 4px 0 var(--shadow);
        margin-bottom: 1.5rem;
        overflow: hidden;
      }

      .sidebar-header {
        background: var(--grass-green);
        color: white;
        padding: 1rem 1.25rem;
        font-weight: 700;
        font-size: 1rem;
        border-bottom: 3px solid var(--dark-stone);
      }

      .sidebar-content {
        padding: 1.25rem;
      }

      .requirements-list {
        list-style: none;
        margin: 0;
      }

      .requirements-list li {
        padding: 0.5rem 0;
        border-bottom: 2px dashed #ddd;
      }

      .requirements-list li:last-child {
        border-bottom: none;
      }

      .requirements-list li:before {
        content: "⚙️ ";
        margin-right: 0.5rem;
      }

      .tags-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .tag-item {
        background: var(--light-bg);
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        font-size: 0.85rem;
        border: 2px solid var(--stone-gray);
        color: var(--dark-stone);
      }

      .related-posts {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .related-post-item-sidebar {
        display: block;
        text-decoration: none;
        padding: 1rem;
        background: var(--light-bg);
        border: 2px solid var(--dark-stone);
        border-radius: 6px;
        transition: all 0.2s;
      }

      .related-post-item-sidebar:hover {
        background: white;
        transform: translateX(4px);
      }

      .related-post-title {
        font-weight: 700;
        color: var(--dark-stone);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
      }

      .related-post-desc {
        font-size: 0.85rem;
        color: #666;
        line-height: 1.5;
      }

      /* Product Cards in Sidebar */
      .sidebar-section h3 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--dark-stone);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--grass-green);
      }

      .product-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 1.5rem;
        position: relative;
      }

      .product-card.sale {
        border: 2px solid #ff5722;
      }

      .sale-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #ff5722;
        color: white;
        padding: 0.3rem 0.6rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
        z-index: 1;
      }

      .product-image {
        width: 100%;
        height: 150px;
        object-fit: cover;
        display: block;
      }

      .product-card h4 {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--dark-stone);
        margin: 1rem 1rem 0.5rem;
      }

      .product-card p {
        font-size: 0.85rem;
        color: #666;
        margin: 0 1rem 0.5rem;
        line-height: 1.5;
      }

      .product-card .price {
        font-size: 1.1rem;
        font-weight: 700;
        color: #ff5722;
        margin: 0.5rem 1rem;
      }

      .original-price {
        text-decoration: line-through;
        color: #999;
        font-size: 0.9rem;
        margin-left: 0.5rem;
      }

      .product-card .button {
        display: block;
        background: var(--grass-green);
        color: white;
        text-align: center;
        padding: 0.75rem;
        text-decoration: none;
        font-weight: 700;
        transition: all 0.2s;
        border-top: 2px solid #eee;
      }

      .product-card .button:hover {
        background: #8bc34a;
      }

      .product-card .sale-button {
        background: #ff5722;
      }

      .product-card .sale-button:hover {
        background: #ff7043;
      }

      /* Responsive */
      @media (max-width: 992px) {
        .content-wrapper {
          grid-template-columns: 1fr;
        }

        .sidebar-section {
          max-width: 600px;
          width: 100%;
          margin-left: auto;
          margin-right: auto;
        }
      }

      @media (max-width: 768px) {
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
          overflow-wrap: break-word; /* 追加 */
          word-break: break-word; /* 追加 */
        }

        h1.page-title {
          font-size: 1.1rem;
          word-break: break-word;
          overflow-wrap: break-word;
        }

        .back-link {
          font-size: 0.9rem;
          margin-bottom: 0.75rem;
        }

        .hero-section {
          margin: -20px auto 2rem;
          padding: 0 1rem;
        }

        .hero-card {
          border-width: 3px;
        }

        .hero-image {
          height: 200px;
          font-size: 3rem;
          border-bottom-width: 3px;
        }

        .hero-info {
          padding: 1.25rem;
        }

        .mod-meta-large {
          gap: 0.5rem;
          margin-bottom: 1rem;
        }

        .mod-tag-large {
          padding: 0.5rem 0.9rem;
          font-size: 0.8rem;
          border-width: 2px;
        }

        .mod-description-large {
          font-size: 0.95rem;
          margin-bottom: 1rem;
        }

        .mod-dates {
          flex-direction: column;
          gap: 0.75rem;
          font-size: 0.85rem;
        }

        .download-section {
          padding: 0 1rem;
          margin-bottom: 2rem;
        }

        .download-buttons {
          padding: 1rem;
          gap: 0.75rem;
          border-width: 3px;
        }

        .download-btn {
          padding: 0.85rem 1.5rem;
          font-size: 1rem;
          border-width: 2px;
        }

        .main-content {
          padding: 1.25rem;
          border-width: 3px;
        }

        .main-content h2 {
          font-size: 1.4rem;
          margin-top: 1.5rem;
          word-break: break-word;
          overflow-wrap: break-word;
        }

        .main-content h3 {
          font-size: 1.2rem;
        }

        .main-content p,
        .main-content li {
          font-size: 0.95rem;
        }

        .sidebar-section {
          border-width: 3px;
          margin-bottom: 1rem;
          width: 100%;
        }

        .sidebar-header {
          padding: 0.85rem 1rem;
          font-size: 0.95rem;
          border-bottom-width: 2px;
        }

        .sidebar-content {
          padding: 1rem;
        }

        .content-wrapper {
          padding: 0 1rem 2rem;
        }

        .related-post-item-sidebar {
          padding: 0.85rem;
          margin-bottom: 0.75rem;
        }

        .related-post-title {
          font-size: 0.9rem;
        }

        .related-post-desc {
          font-size: 0.85rem;
        }

        .post-grid {
          grid-template-columns: 1fr;
          overflow: hidden;
        }
      }

      @media (max-width: 480px) {
        .hero-section {
          padding: 0 0.75rem;
        }

        .download-section {
          padding: 0 0.75rem;
        }

        .content-wrapper {
          padding: 0 0.75rem 2rem;
        }

        h1.page-title {
          font-size: 0.8rem;
        }

        .hero-image {
          height: 160px;
          font-size: 2.5rem;
        }

        .hero-info {
          padding: 1rem;
        }

        .mod-tag-large {
          padding: 0.4rem 0.75rem;
          font-size: 0.75rem;
        }

        .mod-description-large {
          font-size: 0.9rem;
        }

        .download-btn {
          padding: 0.75rem 1.25rem;
          font-size: 0.95rem;
        }

        .main-content {
          padding: 1rem;
        }

        .main-content h2 {
          font-size: 1.2rem;
        }

        .main-content h3 {
          font-size: 1.05rem;
        }
      }
    </style>
  </head>

  <script
    async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4929223237591717"
    crossorigin="anonymous"></script>

  <body>
    <Header />

    <header class="mod-header">
      <div class="header-content">
        <a href="/minecraft_mod_blog/1" class="back-link"> ← MOD一覧に戻る </a>
        <h1 class="page-title">{post.data.title}</h1>
      </div>
    </header>

    <div class="hero-section">
      <div class="hero-card">
        <div class="hero-image">
          {
            post.data.heroImage ? (
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                width="1200"
                height="400"
                loading="eager"
                fetchpriority="high"
              />
            ) : (
              <span>🎮</span>
            )
          }
        </div>
        <div class="hero-info">
          <div class="mod-meta-large">
            {
              post.data.version && (
                <span class="mod-tag-large version">
                  📦 {post.data.version}
                </span>
              )
            }
            {
              post.data.category && (
                <span class="mod-tag-large category">
                  📁 {post.data.category}
                </span>
              )
            }
            {
              post.data.downloads && (
                <span class="mod-tag-large downloads">
                  ⬇️ {post.data.downloads}
                </span>
              )
            }
            {
              post.data.difficulty && (
                <span class="mod-tag-large difficulty">
                  🎯 {post.data.difficulty}
                </span>
              )
            }
            {
              post.data.author && (
                <span class="mod-tag-large author">👤 {post.data.author}</span>
              )
            }
            {
              post.data.modLoader && (
                <span class="mod-tag-large modloader">
                  {Array.isArray(post.data.modLoader)
                    ? post.data.modLoader.join(" / ")
                    : post.data.modLoader}
                </span>
              )
            }
          </div>

          <p class="mod-description-large">{post.data.description}</p>

          <div class="mod-dates">
            <div class="mod-date-item">
              <span class="mod-date-label">公開日</span>
              <FormattedDate date={post.data.pubDate} />
            </div>
            {
              post.data.updatedDate && (
                <div class="mod-date-item">
                  <span class="mod-date-label">更新日</span>
                  <FormattedDate date={post.data.updatedDate} />
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>

    {
      (post.data.downloadLink ||
        post.data.curseforgeUrl ||
        post.data.modrinthUrl ||
        post.data.neoforgeUrl ||
        post.data.fabricUrl ||
        post.data.quiltUrl) && (
        <div class="download-section">
          <div class="download-buttons">
            {post.data.downloadLink && (
              <a
                href={post.data.downloadLink}
                class="download-btn primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                ⬇️ ダウンロード
              </a>
            )}
            {post.data.curseforgeUrl && (
              <a
                href={post.data.curseforgeUrl}
                class="download-btn secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                🔥 CurseForge
              </a>
            )}
            {post.data.modrinthUrl && (
              <a
                href={post.data.modrinthUrl}
                class="download-btn secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                🟢 Modrinth
              </a>
            )}
            {post.data.neoforgeUrl && (
              <a
                href={post.data.neoforgeUrl}
                class="download-btn neoforge"
                target="_blank"
                rel="noopener noreferrer"
              >
                🔨 NeoForge
              </a>
            )}
            {post.data.fabricUrl && (
              <a
                href={post.data.fabricUrl}
                class="download-btn fabric"
                target="_blank"
                rel="noopener noreferrer"
              >
                🪡 Fabric
              </a>
            )}
            {post.data.quiltUrl && (
              <a
                href={post.data.quiltUrl}
                class="download-btn quilt"
                target="_blank"
                rel="noopener noreferrer"
              >
                🧵 Quilt
              </a>
            )}
          </div>
        </div>
      )
    }

    <div class="content-wrapper">
      <article class="main-content">
        <Content />

        <!-- Content AdSense -->
        <div class="content-ad">
          <script
            async
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4929223237591717"
            crossorigin="anonymous"></script>
          <!-- ads2 -->
          <ins
            class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-4929223237591717"
            data-ad-slot="5954046828"
            data-ad-format="auto"
            data-full-width-responsive="true"></ins>
          <script is:inline>
            (adsbygoogle = window.adsbygoogle || []).push({});
          </script>
        </div>

        <div class="simple-related">
          <h3>🔗 こちらの記事もオススメ！</h3>
          <ul>
            <li><a href="/minecraft_mod_blog/curseforgedlinfo">【2025年最新】MinecraftのCurseForge導入方法とおすすめMod10選！</a></li>
            <li><a href="/minecraft_mod_blog/the-twilight-forest">The Twilight Forest - 黄昏の森　導入方法から詳しく解説！何回でも噛めるスルメディメンション！【マイクラMOD】</a></li>
          </ul>
        </div>

        <style>
          .simple-related {
            background: #f8f9fa;
            border-left: 4px solid #667eea;
            border-radius: 0 8px 8px 0;
            padding: 1.5rem;
            margin: 2rem 0;
          }

          .simple-related h3 {
            color: #333;
            margin-bottom: 1rem;
            font-size: 1.2rem;
          }

          .simple-related ul {
            list-style: none;
            margin: 0;
            padding: 0;
          }

          .simple-related li {
            margin-bottom: 0.75rem;
          }

          .simple-related a {
            color: #667eea;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
          }

          .simple-related a:hover {
            color: #5a6fd8;
            text-decoration: underline;
          }

          /* スマホ版サイトの横はみ出し防止 */
          @media (max-width: 768px) {
            * {
              max-width: 100% !important;
              box-sizing: border-box !important;
              word-wrap: break-word !important;
              overflow-wrap: break-word !important;
            }

            html,
            body {
              overflow-x: hidden !important;
              width: 100% !important;
              max-width: 100vw !important;
            }

            .container {
              max-width: 100vw !important;
              margin: 0 !important;
              padding: 0 !important;
              width: 100% !important;
            }

            .main-content {
              padding: 0 10px !important;
              max-width: 100% !important;
              overflow-x: hidden !important;
            }

            .article-area {
              max-width: 100% !important;
              overflow-x: hidden !important;
            }

            .prose {
              max-width: 100% !important;
              overflow-x: hidden !important;
            }

            /* テーブルの横スクロール対応 */
            table {
              display: block !important;
              overflow-x: auto !important;
              white-space: nowrap !important;
              max-width: 100% !important;
            }

            /* 画像の横はみ出し防止 */
            img {
              max-width: 100% !important;
              height: auto !important;
              width: auto !important;
            }

            /* 長いURL・テキストの改行 */
            a,
            p,
            span,
            div,
            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
              word-break: break-all !important;
              overflow-wrap: break-word !important;
              hyphens: auto !important;
            }

            /* コードブロックの横スクロール */
            pre,
            code {
              overflow-x: auto !important;
              max-width: 100% !important;
            }
          }

          @media (max-width: 480px) {
            .container {
              margin: 0 !important;
              border-radius: 0 !important;
              box-shadow: none !important;
              width: 100vw !important;
              max-width: 100vw !important;
            }

            .main-content {
              padding: 0 5px !important;
            }
          }
        </style>

        <!-- おすすめの記事 -->
        <div class="recommended-posts">
          <h3>📚 おすすめの記事</h3>
          <div class="post-grid">
            {
              recommendedPosts.map((recommendedPost) => (
                <a
                  href={`/minecraft_mod_blog/${recommendedPost.id}`}
                  class="related-post-item"
                  style="text-decoration:none;"
                >
                  <div class="post-image">
                    <img
                      src={
                        recommendedPost.data.heroImage ??
                        "/placeholder-image.jpg"
                      }
                      alt={recommendedPost.data.title}
                      width="300"
                      height="180"
                      loading="lazy"
                    />
                  </div>
                  <div class="post-content">
                    <h4>{recommendedPost.data.title}</h4>
                    <p class="post-meta">
                      {recommendedPost.data.pubDate
                        ? new Date(
                            recommendedPost.data.pubDate,
                          ).toLocaleDateString("ja-JP")
                        : ""}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <!-- Tips セクション -->
        <div class="tips">
          <h4>💡 ゲームやデバイスについての最新情報をお届けします</h4>
          <ul>
            <li>
              <strong>ドネーション:</strong> 現在は個人でサイトを運用していますが、高いサーバー代や運営費用がかかっています。もしこのサイトがいいなって思ってくださった方がいましたら是非、<a
                href="https://coff.ee/anygamesjp"
                target="_blank"
                rel="noopener noreferrer">コーヒーを買って応援</a
              >していただけると嬉しいです。
            </li>
            <li>
              <strong>フィードバック:</strong> 記事の内容や広告についてのご意見をお待ちしています。<br
              />
              <a
                href="https://forms.gle/your-feedback-form"
                target="_blank"
                rel="noopener noreferrer">こちらから</a
              >ご連絡ください。
            </li>
            <li>
              <strong>広告掲載:</strong> 当サイトでは、ゲームやデバイスに関連する広告を掲載しています。興味のある方は<a
                href="/about"
                target="_blank"
                rel="noopener noreferrer">こちらから</a
              >お問い合わせください。
            </li>
          </ul>
        </div>
      </article>

      <aside>
        {
          post.data.requirements && post.data.requirements.length > 0 && (
            <div class="sidebar-section">
              <div class="sidebar-header">前提MOD</div>
              <div class="sidebar-content">
                <ul class="requirements-list">
                  {post.data.requirements.map((req) => (
                    <li>{req}</li>
                  ))}
                </ul>
              </div>
            </div>
          )
        }

        {
          post.data.tags && post.data.tags.length > 0 && (
            <div class="sidebar-section">
              <div class="sidebar-header">タグ</div>
              <div class="sidebar-content">
                <div class="tags-list">
                  {post.data.tags.map((tag) => (
                    <span class="tag-item">#{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          )
        }

        {
          relatedPosts.length > 0 && (
            <div class="sidebar-section">
              <div class="sidebar-header">関連記事</div>
              <div class="sidebar-content">
                <div class="related-posts">
                  {relatedPosts.map((relatedPost) => (
                    <a
                      href={`/minecraft_mod_blog/${relatedPost.id}`}
                      class="related-post-item-sidebar"
                    >
                      <div class="related-post-title">
                        {relatedPost.data.title}
                      </div>
                      <div class="related-post-desc">
                        {relatedPost.data.description.slice(0, 60)}...
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          )
        }

        <!-- Sidebar Products -->
        <div class="sidebar-section">
          <div class="sidebar-content">
            <h3>🍩 ゲームのお供に！</h3>
            <div class="product-card">
              <img
                src="/affiliate/otoko.png"
                alt="ノーベル製菓 男梅ソフトキャンデー"
                class="product-image"
                width="280"
                height="150"
                loading="lazy"
              />
              <h4>ノーベル製菓 男梅ソフトキャンデー</h4>
              <p>旨さの神髄ここにあり!</p>
              <p class="price">¥927</p>
              <a href="https://amzn.to/40I0D6r" target="_blank" class="button"
                >Amazonで見る</a
              >
            </div>
          </div>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-content">
            <h3>📈 人気ランキング</h3>
            <div class="product-card">
              <img
                src="/affiliate/head.png"
                alt="Logitech G PRO X"
                class="product-image"
                width="280"
                height="150"
                loading="lazy"
              />
              <h4>Logitech G PRO X</h4>
              <p>プロゲーマー仕様の高性能ヘッドセット</p>
              <p class="price">¥12,800</p>
              <a href="https://amzn.to/46urmHn" target="_blank" class="button"
                >Amazonで見る</a
              >
            </div>
          </div>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-content">
            <h3>🔥 今週のセール</h3>
            <div class="product-card sale">
              <div class="sale-badge">6% OFF</div>
              <img
                src="/affiliate/chair.png"
                alt="GTRACING JP-GT002F-CF"
                class="product-image"
                width="280"
                height="150"
                loading="lazy"
              />
              <h4>GTRACING ゲーミングチェア オットマン付き</h4>
              <p>快適な座り心地で長時間のゲームプレイも安心</p>
              <p class="price">
                ¥20,500 <span class="original-price">¥21,800</span>
              </p>
              <a
                href="https://amzn.to/4kLUQUA"
                target="_blank"
                class="button sale-button">セール価格で見る</a
              >
            </div>
          </div>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-content">
            <div class="product-card sale">
              <div class="sale-badge">6% OFF</div>
              <img
                src="/affiliate/razerv4.png"
                alt="Razer BlackWidow V4 Pro"
                class="product-image"
                width="280"
                height="150"
                loading="lazy"
              />
              <h4>Razer BlackWidow V4 Pro</h4>
              <p>最新のメカニカルゲーミングキーボード</p>
              <p class="price">
                ¥34,870 <span class="original-price">¥36,960</span>
              </p>
              <a
                href="https://amzn.to/4nAYUK0"
                target="_blank"
                class="button sale-button">セール価格で見る</a
              >
            </div>
          </div>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-content">
            <div class="product-card">
              <img
                src="/affiliate/mouse.png"
                alt="Logicool G PRO 2 LIGHTSPEED"
                class="product-image"
                width="280"
                height="150"
                loading="lazy"
              />
              <h4>Logicool G PRO 2 LIGHTSPEED</h4>
              <p>次世代ワイヤレスゲーミングマウス</p>
              <p class="price">¥17,600</p>
              <a href="https://amzn.to/44OmvQ1" target="_blank" class="button"
                >Amazonで見る</a
              >
            </div>
          </div>
        </div>
      </aside>
    </div>

    <Footer />
  </body>
</html>
