# ANYGAMES (Astro 静的サイト) 用 .htaccess — ロリポップ(Apache)向け
# dist/ の中身と一緒にドキュメントルートへ置く。

# 存在しないURLは 404.html を表示(HTTPステータスも404のまま返る)
ErrorDocument 404 /404.html

# ディレクトリ型URL(/blog/xxx/)。末尾スラッシュなしでアクセスされた場合は
# Apacheが自動で /blog/xxx/ に 301 で転送する(旧URL /blog/xxx もこれで表示される)
DirectoryIndex index.html
Options -Indexes

# 圧縮
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# ブラウザキャッシュ(画像・フォント・ビルド生成物は長め、HTMLは短め)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/wasm "access plus 1 week"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

# WebAssembly(画像ツール用)を正しいMIMEタイプで配信
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType image/avif .avif
</IfModule>

# 基本のセキュリティヘッダー
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
