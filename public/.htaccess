# ANYGAMES (Astro 静的サイト) 用 .htaccess — ロリポップ(Apache)向け
# dist/ の中身と一緒にドキュメントルートへ置く。

# ---- HTTPS 強制 / www なしに統一(301)------------------------------------
# ロリポップの独自SSLが有効になっている前提。リダイレクトループ防止のため
# リバースプロキシ経由の X-Forwarded-Proto も見ている。
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://anygamesjp.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.anygamesjp\.com$ [NC]
  RewriteRule ^ https://anygamesjp.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- 旧URLの整理(301)----------------------------------------------------
# 一覧が /blog/page/N/ と /blog/N/ の二重になっていたため、後者(/blog/ 系)に統一
<IfModule mod_alias.c>
  RedirectMatch 301 ^/(blog|device|mobileblog)/page/[0-9]+/?$ /$1/
  RedirectMatch 301 ^/(minecraft_blog|minecraft_mod_blog)/1/?$ /$1/
  # 大文字の /Link/ は小文字の /link/ に統一
  RedirectMatch 301 ^/Link/?$ /link/
</IfModule>

# 存在しないURLは 404.html を表示(HTTPステータスも404のまま返る)
ErrorDocument 404 /404.html

# ディレクトリ型URL(/blog/xxx/)。末尾スラッシュなしでアクセスされた場合は
# Apacheが自動で /blog/xxx/ に 301 で転送する(旧URL /blog/xxx もこれで表示される)
DirectoryIndex index.html
Options -Indexes

# 圧縮
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# ブラウザキャッシュ(画像・フォント・ビルド生成物は長め、HTMLは短め)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/wasm "access plus 1 week"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

# WebAssembly(画像ツール用)を正しいMIMEタイプで配信
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType image/avif .avif
</IfModule>

# 基本のセキュリティヘッダー
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # HSTS: まず短い期間(5分)で開始。HTTPSで問題なく見られることを確認してから
  # 86400(1日) → 2592000(30日) → 31536000(1年) と延ばす。
  Header set Strict-Transport-Security "max-age=300" "expr=%{HTTPS} == 'on'"
</IfModule>

# /_astro/ 配下はファイル名にハッシュが付く(内容が変われば名前も変わる)ため長期キャッシュして安全
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|wasm|woff2)$">
    <If "%{REQUEST_URI} =~ m#^/_astro/#">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
</IfModule>
